digraph "DTH-HRH overlay on the DPI-H reference architecture — metamodel in use" {
  graph [rankdir=TB, newrank=true, fontname="Helvetica", fontsize=11, nodesep=0.6, ranksep=1.3];
  node [shape=box, style="filled", fontname="Helvetica", fontsize=11, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333"];
  subgraph cluster_0 {
    label="Motivation"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "Goal" [label="Goal
1 element(s)", class="mm-layer-motivation", fillcolor="#ccccff", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-Goal", target="_top", tooltip="Goal: its elements"];
    "Outcome" [label="Outcome
9 element(s)", class="mm-layer-motivation", fillcolor="#ccccff", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-Outcome", target="_top", tooltip="Outcome: its elements"];
    "Stakeholder" [label="Stakeholder
6 element(s)", class="mm-layer-motivation", fillcolor="#ccccff", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-Stakeholder", target="_top", tooltip="Stakeholder: its elements"];
    "Value" [label="Value
5 element(s)", class="mm-layer-motivation", fillcolor="#ccccff", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-Value", target="_top", tooltip="Value: its elements"];
  }
  subgraph cluster_1 {
    label="Strategy"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "Capability" [label="Capability
7 element(s)", class="mm-layer-strategy", fillcolor="#f5deaa", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-Capability", target="_top", tooltip="Capability: its elements"];
  }
  subgraph cluster_2 {
    label="Application"; labeljust=l; style="rounded,filled"; fillcolor="#f7f7f7"; color="#bbbbbb"; fontcolor="#666666";
    rank=same;
    "ApplicationComponent" [label="Application Component
5 element(s)
(to itself: flows to ×7)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-ApplicationComponent", target="_top", tooltip="Application Component: its elements"];
    "ApplicationFunction" [label="Application Function
4 element(s)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-ApplicationFunction", target="_top", tooltip="Application Function: its elements"];
    "ApplicationService" [label="Application Service
4 element(s)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-ApplicationService", target="_top", tooltip="Application Service: its elements"];
    "DataObject" [label="Data Object
5 element(s)
(to itself: aggregates ×1)", class="mm-layer-application", fillcolor="#b5ffff", URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#type-DataObject", target="_top", tooltip="Data Object: its elements"];
  }
  "Goal" -> "Capability" [style=invis, constraint=true, weight=10];
  "Capability" -> "ApplicationComponent" [style=invis, constraint=true, weight=10];
  "ApplicationComponent" -> "DataObject" [label="accesses ×6", class="mm-cat-dependency mm-from-application mm-to-application", style=dotted, arrowhead=vee, arrowsize=0.6, URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationComponent-DataObject", target="_top", tooltip="Application Component → Data Object: its relationships"];
  "Capability" -> "Outcome" [label="realises ×6", class="mm-cat-structural mm-from-strategy mm-to-motivation", style=dashed, arrowhead=empty, URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#pattern-Capability-Outcome", target="_top", tooltip="Capability → Outcome: its relationships"];
  "Value" -> "Outcome" [label="influences ×5", class="mm-cat-dependency mm-from-motivation mm-to-motivation", style=dashed, arrowhead=vee, URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#pattern-Value-Outcome", target="_top", tooltip="Value → Outcome: its relationships"];
  "ApplicationComponent" -> "ApplicationFunction" [label="assigned to ×4", class="mm-cat-structural mm-from-application mm-to-application", dir=both, arrowtail=dot, arrowhead=normal, URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationComponent-ApplicationFunction", target="_top", tooltip="Application Component → Application Function: its relationships"];
  "ApplicationFunction" -> "ApplicationService" [label="realises ×4", class="mm-cat-structural mm-from-application mm-to-application", style=dashed, arrowhead=empty, URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationFunction-ApplicationService", target="_top", tooltip="Application Function → Application Service: its relationships"];
  "ApplicationComponent" -> "Outcome" [label="realises ×3", class="mm-cat-structural mm-from-application mm-to-motivation", style=dashed, arrowhead=empty, URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationComponent-Outcome", target="_top", tooltip="Application Component → Outcome: its relationships"];
  "ApplicationFunction" -> "DataObject" [label="accesses ×1", class="mm-cat-dependency mm-from-application mm-to-application", style=dotted, arrowhead=vee, arrowsize=0.6, URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationFunction-DataObject", target="_top", tooltip="Application Function → Data Object: its relationships"];
  "ApplicationService" -> "Capability" [label="realises ×1", class="mm-cat-structural mm-from-application mm-to-strategy", style=dashed, arrowhead=empty, URL="../../en/dth-hrh/archimate/0.1.0-draft.1/metamodel/#pattern-ApplicationService-Capability", target="_top", tooltip="Application Service → Capability: its relationships"];
}
