  "title": "4-01 Labour regulations and policies for health workforce",
  "text": "ind-nhwa-4-01.md",
  "meta": {
    "indicatorId": "4-01",
    "module": "Module 4: Working conditions, governance and leadership",
    "abbreviatedName": "Labour regulations and policies for health workforce",
    "name": "Existence of labour regulations and policies on the employment characteristics, protection and working conditions of the health workforce",
    "definition": "This indicator is a composite of twelve sub-indicators, see below. The response to these twelve\nsub-indicators is aggregated as a score (see part II on methods) on a scale from 1 (nascent) to 5\n(sustainable).\nEach sub-indicator is a self-assessment of one aspect of labour regulation and policies, primarily\nto protect and safeguard health and care workers. To help answer these self-assessed sub-indicators,\na series of guiding questions are provided.",
    "glossary": "Status in employment; Occupation; Community health workers; Childcare support; Continuing professional development; In-service training; Leave entitlements to care for sick family members; Parental leave; Dual practice",
    "reportingFrequency": "Every three years",
    "reportingFrameworks": "Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM), Global Health and Care Worker Compact, Community Health Workers (CHWs)",
    "dataSources": "Employment laws, policies and regulations; Social security records; Government or legislative records; Survey among country experts or informants; Policy and strategic documents of governments and competent authorities",
    "furtherInformation": "(6, 78-85)",
    "subIndicators": "4-01.1; 4-01.2; 4-01.3; 4-01.4; 4-01.5; 4-01.6; 4-01.7; 4-01.8; 4-01.9; 4-01.10; 4-01.11; 4-01.12",
