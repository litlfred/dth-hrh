<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_HRH_DT_01"
             name="HRH-DT-01 Registration eligibility and duplicate check"
             namespace="https://litlfred.github.io/dth-hrh/dmn/hrh-dt-01">

  <decision id="Decision_HRH_DT_01" name="Health worker registration eligibility and identifier assignment">
    <description>Determines whether a registration application creates a new registry record, links to an existing record, holds for manual duplicate or verification review, or is rejected. Source passages: prose:ch07-identity-management (Section 7.1), freq:FR-ID-01 (Unique health worker identifier), freq:FR-ID-02 (Deduplication), freq:FR-REC-01 (Core data elements), freq:FR-REC-02 (Qualifications and licences), scen:register-and-license-new-graduate (Section 5.2). Threshold provenance: qualitative states only from source text; no numeric thresholds are specified in the narrative.</description>

    <decisionTable id="DecisionTable_HRH_DT_01" hitPolicy="FIRST">

      <input id="Input_DT01_Identity" label="Identity and national ID check (freq:FR-ID-01)">
        <inputExpression id="InputExpr_DT01_Identity" typeRef="string">
          <text>identityStatus</text>
        </inputExpression>
      </input>

      <input id="Input_DT01_Qualification" label="Primary-source qualification attestation (freq:FR-REC-01, freq:FR-REC-02)">
        <inputExpression id="InputExpr_DT01_Qualification" typeRef="string">
          <text>qualificationAttestation</text>
        </inputExpression>
      </input>

      <input id="Input_DT01_Duplicate" label="Deduplication check result (freq:FR-ID-02)">
        <inputExpression id="InputExpr_DT01_Duplicate" typeRef="string">
          <text>duplicateMatch</text>
        </inputExpression>
      </input>

      <input id="Input_DT01_Standing" label="Prior regulatory standing (freq:FR-REC-02)">
        <inputExpression id="InputExpr_DT01_Standing" typeRef="string">
          <text>regulatoryStanding</text>
        </inputExpression>
      </input>

      <output id="Output_DT01_Decision" name="registrationDecision" label="Registration decision" typeRef="string"/>
      <output id="Output_DT01_IdAction" name="identifierAction" label="Identifier action (freq:FR-ID-01)" typeRef="string"/>

      <!-- Rule 1: Disqualified / revoked standing or invalid qualification -> reject -->
      <rule id="Rule_DT01_01">
        <description>Applicant has a revoked or disqualified regulatory standing: reject registration (freq:FR-REC-02, Section 7.2).</description>
        <inputEntry id="IE_DT01_01_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_01_2"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_01_3"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_01_4"><text>"revoked", "disqualified"</text></inputEntry>
        <outputEntry id="OE_DT01_01_1"><text>"reject-disqualified"</text></outputEntry>
        <outputEntry id="OE_DT01_01_2"><text>"none"</text></outputEntry>
      </rule>

      <!-- Rule 2: Qualification explicitly unverified/invalid or identity rejected -> reject -->
      <rule id="Rule_DT01_02">
        <description>Primary-source qualification attestation or identity check failed: reject registration (freq:FR-ID-01, freq:FR-REC-01, scen:register-and-license-new-graduate).</description>
        <inputEntry id="IE_DT01_02_1"><text>"rejected"</text></inputEntry>
        <inputEntry id="IE_DT01_02_2"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_02_3"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_02_4"><text>-</text></inputEntry>
        <outputEntry id="OE_DT01_02_1"><text>"reject-unverified-identity"</text></outputEntry>
        <outputEntry id="OE_DT01_02_2"><text>"none"</text></outputEntry>
      </rule>

      <rule id="Rule_DT01_03">
        <description>Training institution rejected or could not confirm the claimed qualification: reject registration (freq:FR-REC-01, freq:FR-REC-02).</description>
        <inputEntry id="IE_DT01_03_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_03_2"><text>"rejected"</text></inputEntry>
        <inputEntry id="IE_DT01_03_3"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_03_4"><text>-</text></inputEntry>
        <outputEntry id="OE_DT01_03_1"><text>"reject-unverified-qualification"</text></outputEntry>
        <outputEntry id="OE_DT01_03_2"><text>"none"</text></outputEntry>
      </rule>

      <!-- Rule 4: Candidate duplicate found -> hold for manual review before creating a second record -->
      <rule id="Rule_DT01_04">
        <description>Deduplication check flags a candidate duplicate record: hold for manual review and merge adjudication rather than creating a second record (freq:FR-ID-02, Section 7.1).</description>
        <inputEntry id="IE_DT01_04_1"><text>"verified", "verified-without-national-id"</text></inputEntry>
        <inputEntry id="IE_DT01_04_2"><text>"attested"</text></inputEntry>
        <inputEntry id="IE_DT01_04_3"><text>"candidate-duplicate"</text></inputEntry>
        <inputEntry id="IE_DT01_04_4"><text>"good-standing", "new-graduate"</text></inputEntry>
        <outputEntry id="OE_DT01_04_1"><text>"hold-duplicate-review"</text></outputEntry>
        <outputEntry id="OE_DT01_04_2"><text>"review-candidate-match"</text></outputEntry>
      </rule>

      <!-- Rule 5: Confirmed existing registry record -> link to existing persistent HWR identifier -->
      <rule id="Rule_DT01_05">
        <description>Applicant matches an existing verified health worker record (e.g. additional cadre or specialty): register qualification and reuse persistent identifier (freq:FR-ID-01, freq:FR-ID-02, freq:FR-REC-02).</description>
        <inputEntry id="IE_DT01_05_1"><text>"verified", "verified-without-national-id"</text></inputEntry>
        <inputEntry id="IE_DT01_05_2"><text>"attested"</text></inputEntry>
        <inputEntry id="IE_DT01_05_3"><text>"existing-confirmed"</text></inputEntry>
        <inputEntry id="IE_DT01_05_4"><text>"good-standing", "new-graduate"</text></inputEntry>
        <outputEntry id="OE_DT01_05_1"><text>"register-and-license"</text></outputEntry>
        <outputEntry id="OE_DT01_05_2"><text>"reuse-existing-hwr-id"</text></outputEntry>
      </rule>

      <!-- Rule 6: Verified identity + attested qualification + no duplicate + good standing -> issue new HWR ID -->
      <rule id="Rule_DT01_06">
        <description>Identity verified (with national ID where available and lawful), qualification attested by training institution, no duplicate found, and applicant in good standing: approve registration and assign new persistent HWR identifier (freq:FR-ID-01, freq:FR-REC-01, freq:FR-REC-02).</description>
        <inputEntry id="IE_DT01_06_1"><text>"verified", "verified-without-national-id"</text></inputEntry>
        <inputEntry id="IE_DT01_06_2"><text>"attested"</text></inputEntry>
        <inputEntry id="IE_DT01_06_3"><text>"none"</text></inputEntry>
        <inputEntry id="IE_DT01_06_4"><text>"good-standing", "new-graduate"</text></inputEntry>
        <outputEntry id="OE_DT01_06_1"><text>"register-and-license"</text></outputEntry>
        <outputEntry id="OE_DT01_06_2"><text>"assign-new-hwr-id"</text></outputEntry>
      </rule>

      <!-- Rule 7: Third state (pending / unknown verification) -> hold pending source confirmation -->
      <rule id="Rule_DT01_07">
        <description>Third state: identity check, primary-source qualification attestation, deduplication check or standing is pending or unknown — hold application pending verification without minting an identifier (freq:FR-ID-01, freq:FR-REC-01).</description>
        <inputEntry id="IE_DT01_07_1"><text>"pending", "unknown"</text></inputEntry>
        <inputEntry id="IE_DT01_07_2"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_07_3"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_07_4"><text>-</text></inputEntry>
        <outputEntry id="OE_DT01_07_1"><text>"hold-pending-verification"</text></outputEntry>
        <outputEntry id="OE_DT01_07_2"><text>"none"</text></outputEntry>
      </rule>

      <!-- Rule 8: Catch-all fallback -->
      <rule id="Rule_DT01_08">
        <description>Catch-all rule: any remaining combination of incomplete attestation or unresolved status is held for registration officer review.</description>
        <inputEntry id="IE_DT01_08_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_08_2"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_08_3"><text>-</text></inputEntry>
        <inputEntry id="IE_DT01_08_4"><text>-</text></inputEntry>
        <outputEntry id="OE_DT01_08_1"><text>"hold-pending-verification"</text></outputEntry>
        <outputEntry id="OE_DT01_08_2"><text>"none"</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>
</definitions>
