{
  "contentType": "document",
  "adapter": "document",
  "adapterModule": "./folio-assistant-core/adapters/document/index.ts",
  "dependencies": {
    "folioAssistant": [
      {
        "name": "folio-assistant-core",
        "path": "folio-assistant-core"
      },
      {
        "name": "smart-base",
        "path": "smart-base"
      }
    ]
  },
  "feedbackDir": ".folio-feedback",
  "skills": ".claude/skills/local",
  "viewer": {
    "dir": "cat-harness-tools/viewer",
    "port": 8080
  },
  "readme": {
    "linkStyle": "blob",
    "publishRef": "gh-pages"
  },
  "site": {
    "build": {
      "sourceSteps": [
        "site:document",
        "site:wg-comment",
        "site:library",
        "site:glossary"
      ],
      "siteSteps": [
        "site:node-kinds"
      ],
      "pre": [
        "check:dth-glossary",
        "check:review-anchors",
        "check:kg-blocks",
        "check:library-kg"
      ],
      "coverage": "report"
    }
  }
}
