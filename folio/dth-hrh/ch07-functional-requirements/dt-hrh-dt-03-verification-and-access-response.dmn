<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_HRH_DT_03"
             name="HRH-DT-03 Tiered verification and disclosure response"
             namespace="https://litlfred.github.io/dth-hrh/dmn/hrh-dt-03">

  <decision id="Decision_HRH_DT_03" name="Verification service and tiered disclosure response">
    <description>Determines the disclosure tier and verification response payload returned to a requester based on requester category, authentication/data-sharing authorization, and channel. Source passages: prose:ch07-verification-services (Section 7.4), freq:FR-VER-01 (Public lookup), freq:FR-VER-02 (System-to-system verification), freq:FR-VER-03 (Verifiable digital credentials), freq:FR-AN-03 (De-identified analytics extracts), nfreq:NFR-01 (Role-based access and audit), prose:ch06-legal-foundations (Section 6.2 tiered disclosure). Threshold provenance: qualitative access tiers from source text only; no numeric thresholds are specified in the narrative.</description>

    <decisionTable id="DecisionTable_HRH_DT_03" hitPolicy="FIRST">

      <input id="Input_DT03_Requester" label="Requester role / category (Section 5.1, Section 7.4)">
        <inputExpression id="InputExpr_DT03_Requester" typeRef="string">
          <text>requesterRole</text>
        </inputExpression>
      </input>

      <input id="Input_DT03_Channel" label="Verification or access channel (freq:FR-VER-01, freq:FR-VER-02, freq:FR-VER-03)">
        <inputExpression id="InputExpr_DT03_Channel" typeRef="string">
          <text>channel</text>
        </inputExpression>
      </input>

      <input id="Input_DT03_Auth" label="Authentication and data-sharing authorization (nfreq:NFR-01, Section 6.2)">
        <inputExpression id="InputExpr_DT03_Auth" typeRef="string">
          <text>authorizationState</text>
        </inputExpression>
      </input>

      <output id="Output_DT03_Tier" name="disclosureTier" label="Permitted disclosure tier" typeRef="string"/>
      <output id="Output_DT03_Payload" name="responsePayload" label="Returned payload scope" typeRef="string"/>

      <!-- Rule 1: Public lookup -> public register subset only (freq:FR-VER-01) -->
      <rule id="Rule_DT03_01">
        <description>Member of the public querying the online public register: return only the legally designated public subset (name, cadre, registration number and current licence status) (freq:FR-VER-01, prose:ch06-legal-foundations).</description>
        <inputEntry id="IE_DT03_01_1"><text>"public"</text></inputEntry>
        <inputEntry id="IE_DT03_01_2"><text>"public-web-lookup"</text></inputEntry>
        <inputEntry id="IE_DT03_01_3"><text>"anonymous", "authenticated-authorized"</text></inputEntry>
        <outputEntry id="OE_DT03_01_1"><text>"tier-1-public"</text></outputEntry>
        <outputEntry id="OE_DT03_01_2"><text>"public-status-and-cadre-only"</text></outputEntry>
      </rule>

      <!-- Rule 2: Offline or online presentation of a verifiable credential (freq:FR-VER-03) -->
      <rule id="Rule_DT03_02">
        <description>Verifier checking a health worker's cryptographically signed digital credential online or offline: validate signature and expiry against regulator trust list and return credential attributes (freq:FR-VER-03, nfreq:NFR-03).</description>
        <inputEntry id="IE_DT03_02_1"><text>"public", "employer-or-facility", "point-of-care-system", "emergency-coordinator"</text></inputEntry>
        <inputEntry id="IE_DT03_02_2"><text>"verifiable-credential"</text></inputEntry>
        <inputEntry id="IE_DT03_02_3"><text>"valid-credential-signature"</text></inputEntry>
        <outputEntry id="OE_DT03_02_1"><text>"tier-1-verifiable-credential"</text></outputEntry>
        <outputEntry id="OE_DT03_02_2"><text>"signed-credential-status-and-scope"</text></outputEntry>
      </rule>

      <!-- Rule 3: Point-of-care clinical system or employer / HRIS with active authorization (freq:FR-VER-02) -->
      <rule id="Rule_DT03_03">
        <description>Authenticated and authorized employer, HRIS, emergency coordinator or EMR querying via system-to-system API: return identifier, active licence status, scope of practice and facility affiliation (freq:FR-VER-02, nfreq:NFR-01).</description>
        <inputEntry id="IE_DT03_03_1"><text>"employer-or-facility", "point-of-care-system", "emergency-coordinator"</text></inputEntry>
        <inputEntry id="IE_DT03_03_2"><text>"system-api", "portal"</text></inputEntry>
        <inputEntry id="IE_DT03_03_3"><text>"authenticated-authorized"</text></inputEntry>
        <outputEntry id="OE_DT03_03_1"><text>"tier-2-authorized-operational"</text></outputEntry>
        <outputEntry id="OE_DT03_03_2"><text>"identifier-status-scope-and-affiliation"</text></outputEntry>
      </rule>

      <!-- Rule 4: Workforce planner or NHWA platform requesting analytics (freq:FR-AN-01, freq:FR-AN-02, freq:FR-AN-03) -->
      <rule id="Rule_DT03_04">
        <description>Authenticated workforce planner or NHWA platform: return de-identified aggregate counts and indicator extracts only, with personal identifiers removed (freq:FR-AN-01, freq:FR-AN-02, freq:FR-AN-03).</description>
        <inputEntry id="IE_DT03_04_1"><text>"workforce-planner", "nhwa-platform"</text></inputEntry>
        <inputEntry id="IE_DT03_04_2"><text>"analytics-export", "system-api"</text></inputEntry>
        <inputEntry id="IE_DT03_04_3"><text>"authenticated-authorized"</text></inputEntry>
        <outputEntry id="OE_DT03_04_1"><text>"tier-2-deidentified-analytics"</text></outputEntry>
        <outputEntry id="OE_DT03_04_2"><text>"deidentified-aggregate-indicators-only"</text></outputEntry>
      </rule>

      <!-- Rule 5: Health worker inspecting own record or regulator / custodian performing stewardship (Section 6.3, freq:FR-REC-03) -->
      <rule id="Rule_DT03_05">
        <description>Authenticated health worker viewing own record, or authorized registration officer / custodian: return full authoritative record with provenance and audit history (prose:ch06-data-stewardship, freq:FR-REC-03, nfreq:NFR-01).</description>
        <inputEntry id="IE_DT03_05_1"><text>"self-health-worker", "regulator-or-custodian"</text></inputEntry>
        <inputEntry id="IE_DT03_05_2"><text>"portal", "system-api"</text></inputEntry>
        <inputEntry id="IE_DT03_05_3"><text>"authenticated-authorized"</text></inputEntry>
        <outputEntry id="OE_DT03_05_1"><text>"tier-3-full-record"</text></outputEntry>
        <outputEntry id="OE_DT03_05_2"><text>"full-record-with-provenance"</text></outputEntry>
      </rule>

      <!-- Rule 6: Third state — authorization or credential state unknown / unverified -->
      <rule id="Rule_DT03_06">
        <description>Third state: requester authentication, data-sharing agreement or credential signature is unknown or unverified — deny non-public disclosure and log audit event (nfreq:NFR-01).</description>
        <inputEntry id="IE_DT03_06_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT03_06_2"><text>-</text></inputEntry>
        <inputEntry id="IE_DT03_06_3"><text>"unknown", "pending"</text></inputEntry>
        <outputEntry id="OE_DT03_06_1"><text>"deny-unverified"</text></outputEntry>
        <outputEntry id="OE_DT03_06_2"><text>"none-audit-logged"</text></outputEntry>
      </rule>

      <!-- Rule 7: Catch-all fallback (unauthorized or unsupported channel/role combination) -->
      <rule id="Rule_DT03_07">
        <description>Catch-all rule: any unauthorized or unmatched access request is denied and logged in the security audit trail (nfreq:NFR-01).</description>
        <inputEntry id="IE_DT03_07_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT03_07_2"><text>-</text></inputEntry>
        <inputEntry id="IE_DT03_07_3"><text>-</text></inputEntry>
        <outputEntry id="OE_DT03_07_1"><text>"deny-unauthorized"</text></outputEntry>
        <outputEntry id="OE_DT03_07_2"><text>"none-audit-logged"</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>
</definitions>
