<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_HRH_BP_04"
                  targetNamespace="https://litlfred.github.io/dth-hrh/bpmn">

  <bpmn:resource id="pers:health-worker" name="Health worker"/>
  <bpmn:resource id="pers:employer-hr-manager" name="Employer or facility human resources manager"/>
  <bpmn:resource id="pers:system-facility-registry" name="Facility registry"/>
  <bpmn:resource id="pers:system-hris" name="Human resources information system (HRIS)"/>
  <bpmn:resource id="pers:emergency-coordinator" name="Emergency coordinator"/>

  <bpmn:collaboration id="Collab_HRH_BP_04">
    <bpmn:participant id="Pool_HRH_BP_04" name="HRH-BP-04 Update employment, place of practice and surge deployment" processRef="HRH_BP_04"/>
  </bpmn:collaboration>

  <bpmn:process id="HRH_BP_04" name="Update employment, place of practice and surge deployment (HRH-BP-04)" isExecutable="false">
    <bpmn:documentation>Updates a health worker's employer, position, facility affiliation and emergency surge deployment in the registry while validating facility identifiers against the authoritative facility registry and synchronizing with the HRIS.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_HRH_BP_04">
      <bpmn:lane id="Lane_BP04_HealthWorker" name="Health worker" partitionElementRef="pers:health-worker">
        <bpmn:flowNodeRef>Task_BP04_01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP04_EmployerHR" name="Employer or facility HR manager" partitionElementRef="pers:employer-hr-manager">
        <bpmn:flowNodeRef>Start_BP04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP04_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BP04_Surge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP04_FacilityRegistry" name="Facility registry" partitionElementRef="pers:system-facility-registry">
        <bpmn:flowNodeRef>Task_BP04_03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP04_HRIS" name="Human resources information system (HRIS)" partitionElementRef="pers:system-hris">
        <bpmn:flowNodeRef>Task_BP04_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BP04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP04_EmergencyCoord" name="Emergency coordinator" partitionElementRef="pers:emergency-coordinator">
        <bpmn:flowNodeRef>Task_BP04_05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BP04" name="Posting change or surge need">
      <bpmn:outgoing>Flow_BP04_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_BP04_01" name="Report change of employer or place of practice">
      <bpmn:incoming>Flow_BP04_01</bpmn:incoming>
      <bpmn:outgoing>Flow_BP04_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP04_02" name="Verify active licence and submit appointment/transfer">
      <bpmn:incoming>Flow_BP04_02</bpmn:incoming>
      <bpmn:outgoing>Flow_BP04_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BP04_03" name="Resolve and validate authoritative facility ID">
      <bpmn:incoming>Flow_BP04_03</bpmn:incoming>
      <bpmn:outgoing>Flow_BP04_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BP04_04" name="Synchronize employment and facility affiliation">
      <bpmn:incoming>Flow_BP04_04</bpmn:incoming>
      <bpmn:outgoing>Flow_BP04_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_BP04_Surge" name="Surge deployment?">
      <bpmn:incoming>Flow_BP04_05</bpmn:incoming>
      <bpmn:outgoing>Flow_BP04_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_BP04_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BP04_05" name="Verify credentials and record temporary emergency deployment">
      <bpmn:incoming>Flow_BP04_06</bpmn:incoming>
      <bpmn:outgoing>Flow_BP04_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BP04" name="Affiliation and deployment current">
      <bpmn:incoming>Flow_BP04_07</bpmn:incoming>
      <bpmn:incoming>Flow_BP04_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_BP04_01" sourceRef="Start_BP04" targetRef="Task_BP04_01"/>
    <bpmn:sequenceFlow id="Flow_BP04_02" sourceRef="Task_BP04_01" targetRef="Task_BP04_02"/>
    <bpmn:sequenceFlow id="Flow_BP04_03" sourceRef="Task_BP04_02" targetRef="Task_BP04_03"/>
    <bpmn:sequenceFlow id="Flow_BP04_04" sourceRef="Task_BP04_03" targetRef="Task_BP04_04"/>
    <bpmn:sequenceFlow id="Flow_BP04_05" sourceRef="Task_BP04_04" targetRef="Gw_BP04_Surge"/>
    <bpmn:sequenceFlow id="Flow_BP04_06" sourceRef="Gw_BP04_Surge" targetRef="Task_BP04_05" name="Emergency surge"/>
    <bpmn:sequenceFlow id="Flow_BP04_07" sourceRef="Gw_BP04_Surge" targetRef="End_BP04" name="Routine posting"/>
    <bpmn:sequenceFlow id="Flow_BP04_08" sourceRef="Task_BP04_05" targetRef="End_BP04"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_HRH_BP_04">
    <bpmndi:BPMNPlane id="BPMNPlane_HRH_BP_04" bpmnElement="Collab_HRH_BP_04">
      <bpmndi:BPMNShape id="Pool_HRH_BP_04_di" bpmnElement="Pool_HRH_BP_04" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1650" height="750"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP04_HealthWorker_di" bpmnElement="Lane_BP04_HealthWorker" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP04_EmployerHR_di" bpmnElement="Lane_BP04_EmployerHR" isHorizontal="true">
        <dc:Bounds x="150" y="230" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP04_FacilityRegistry_di" bpmnElement="Lane_BP04_FacilityRegistry" isHorizontal="true">
        <dc:Bounds x="150" y="380" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP04_HRIS_di" bpmnElement="Lane_BP04_HRIS" isHorizontal="true">
        <dc:Bounds x="150" y="530" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP04_EmergencyCoord_di" bpmnElement="Lane_BP04_EmergencyCoord" isHorizontal="true">
        <dc:Bounds x="150" y="680" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_BP04_di" bpmnElement="Start_BP04">
        <dc:Bounds x="202" y="287" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP04_01_di" bpmnElement="Task_BP04_01">
        <dc:Bounds x="340" y="121" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP04_02_di" bpmnElement="Task_BP04_02">
        <dc:Bounds x="525" y="271" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP04_03_di" bpmnElement="Task_BP04_03">
        <dc:Bounds x="710" y="421" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP04_04_di" bpmnElement="Task_BP04_04">
        <dc:Bounds x="895" y="571" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_BP04_Surge_di" bpmnElement="Gw_BP04_Surge" isMarkerVisible="true">
        <dc:Bounds x="1120" y="280" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP04_05_di" bpmnElement="Task_BP04_05">
        <dc:Bounds x="1265" y="721" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_BP04_di" bpmnElement="End_BP04">
        <dc:Bounds x="1497" y="587" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_BP04_01_di" bpmnElement="Flow_BP04_01">
        <di:waypoint x="238" y="305"/>
        <di:waypoint x="289" y="305"/>
        <di:waypoint x="289" y="155"/>
        <di:waypoint x="340" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP04_02_di" bpmnElement="Flow_BP04_02">
        <di:waypoint x="470" y="155"/>
        <di:waypoint x="498" y="155"/>
        <di:waypoint x="498" y="305"/>
        <di:waypoint x="525" y="305"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP04_03_di" bpmnElement="Flow_BP04_03">
        <di:waypoint x="655" y="305"/>
        <di:waypoint x="683" y="305"/>
        <di:waypoint x="683" y="455"/>
        <di:waypoint x="710" y="455"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP04_04_di" bpmnElement="Flow_BP04_04">
        <di:waypoint x="840" y="455"/>
        <di:waypoint x="868" y="455"/>
        <di:waypoint x="868" y="605"/>
        <di:waypoint x="895" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP04_05_di" bpmnElement="Flow_BP04_05">
        <di:waypoint x="1025" y="605"/>
        <di:waypoint x="1073" y="605"/>
        <di:waypoint x="1073" y="305"/>
        <di:waypoint x="1120" y="305"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP04_06_di" bpmnElement="Flow_BP04_06">
        <di:waypoint x="1170" y="305"/>
        <di:waypoint x="1218" y="305"/>
        <di:waypoint x="1218" y="755"/>
        <di:waypoint x="1265" y="755"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP04_07_di" bpmnElement="Flow_BP04_07">
        <di:waypoint x="1170" y="305"/>
        <di:waypoint x="1334" y="305"/>
        <di:waypoint x="1334" y="605"/>
        <di:waypoint x="1497" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP04_08_di" bpmnElement="Flow_BP04_08">
        <di:waypoint x="1395" y="755"/>
        <di:waypoint x="1446" y="755"/>
        <di:waypoint x="1446" y="605"/>
        <di:waypoint x="1497" y="605"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
