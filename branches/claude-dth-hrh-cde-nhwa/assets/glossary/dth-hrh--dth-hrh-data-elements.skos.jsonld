    {
      "@id": "https://litlfred.github.io/dth-hrh/v0/ns/glossary/dth-hrh-data-elements/type-of-contract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-hrh/v0/ns/glossary/dth-hrh-data-elements"
      },
      "skos:prefLabel": [
        {
          "@value": "Type of contract"
        }
      ],
      "skos:definition": [
        {
          "@value": "The contract type is a key employment characteristic of all workers, including health workers. Personnel may be categorized as full-time workers or part-time workers, depending on their specific contract types. Part-time workers refers to those employed persons whose normal hours of work (calculated weekly or on average over a given period of employment) are less than those of comparable full-time workers."
        }
      ],
      "skos:scopeNote": "Data element de:nhwa-m1-type-of-contract: NHWA Module 1 extension (section 11.2). NHWA indicators: 1-12.",
      "skos:editorialNote": "Provisional definition: quoted from the NHWA handbook, 2nd edition (2023), Glossary, entry \"Contract Type\". For working-group review; not adopted.",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/dth-hrh/v0/ns/glossary/dth-hrh/contract-type"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/nhwa-2023/contract-type"
        }
      ],
      "dcterms:source": "uploads/9789240081291-eng/9789240081291-eng.pdf#page=102",
      "skos:note": "candidate"
    },
