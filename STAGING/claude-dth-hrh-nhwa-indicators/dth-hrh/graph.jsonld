pers/dth-hrh/blocks/de-nhwa-m3-employer-sector","@type":["smart-base:DataElement"],"label":"de:nhwa-m3-employer-sector","kind":"data-element","title":"Employer sector","text":"de-nhwa-m3-employer-sector.md","meta":{"source":{"library":"who-iris:9789240081291-eng","sections":["sec-044-3-01-expenditure-on-compensation-of-health-worke","sec-045-3-02-entry-level-wages-and-salaries"],"method":"nhwa-indicator-disaggregation"},"definitionStatus":"working","glossarySource":"twg-glossary-2026-09-29","elementSet":"nhwa-m3","supportsIndicators":["3-01","3-02"]},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/de-nhwa-m3-entry-salary-grade","@type":["smart-base:DataElement"],"label":"de:nhwa-m3-entry-salary-grade","kind":"data-element","title":"Salary grade at entry","text":"de-nhwa-m3-entry-salary-grade.md","meta":{"source":{"library":"who-iris:9789240081291-eng","sections":["sec-045-3-02-entry-level-wages-and-salaries"],"method":"nhwa-indicator-disaggregation"},"definitionStatus":"working","glossarySource":"twg-glossary-2026-09-29","elementSet":"nhwa-m3","supportsIndicators":["3-02"]},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/de-nhwa-m4-leadership-position","@type":["smart-base:DataElement"],"label":"de:nhwa-m4-leadership-position","kind":"data-element","title":"Leadership position","text":"de-nhwa-m4-leadership-position.md","meta":{"source":{"library":"who-iris:9789240081291-eng","sections":["sec-052-4-03-share-of-women-in-leadership-role"],"method":"nhwa-indicator-disaggregation"},"definitionStatus":"working","glossarySource":"twg-glossary-2026-09-29","elementSet":"nhwa-m4","supportsIndicators":["4-03"]},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/de-cde-professional-licence-and-certification","@type":["smart-base:DataElement"],"label":"de:cde-professional-licence-and-certification","kind":"data-element","title":"Professional licence and certification","text":"de-professional-licence-and-certification.md","meta":{"source":{"library":"twg-outline-2026-10-02","file":"library/twg-outline-2026-10-02/HWF_Registry_DTH_Outline.md","method":"outline-seed"},"definitionStatus":"working","glossarySource":"twg-glossary-2026-09-29","elementSet":"cde","supportsIndicators":["1-01"]},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-01","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-01","kind":"indicator","title":"1-01 Health worker density","text":"ind-nhwa-1-01.md","meta":{"indicatorId":"1-01","module":"Module 1: Stock and flow","abbreviatedName":"Health worker density","name":"Density of health workers per 10 000 population","numerator":"Number of active health workers, defined in headcounts","denominator":"Total population","disaggregation":"By occupation, by occupation and activity level","definition":"Number of health workers per 10 000 population.\nFor activity level the following categories are recommended: practising health workers,\nprofessionally active health workers, and health workers licensed to practise.\nTotal population as estimated in the World Population Prospects published by the Population\nDivision of the Department of Economic and Social Affairs of the United Nations Secretariat. In case\nof other methodology used, WHO recalculates densities according to the UN population estimates in\norder to harmonize the densities and ensure comparability.","glossary":"Active health worker; Activity level; Occupation","reportingFrequency":"Annual","reportingFrameworks":"UN SDG 3.c.1, SDG 3.8.1, WHO Global Code of Practice on the International Recruitment of Health Personnel, Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM), Immunization Agenda 2030 (IA2030), SCORE for Health Data Technical Package (SCORE), Primary Health Care (PHC) Measurement Framework, Community Health Workers (CHWs), Global Oral Health Action Plan","dataSources":"Health workforce registry or database; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey); Professional council/chamber/association registers; Labour force surveys; Population census data; United Nations Population Division","furtherInformation":"(5, 6, 9, 31, 33, 45-55)","dataElements":"de:cde-occupation; de:cde-employment-status; de:nhwa-m1-activity-level; de:cde-professional-licence-and-certification","programIndicatorId":"NHWA.1-01","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-023-01","pages":"52","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-02","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-02","kind":"indicator","title":"1-02 Health worker density at subnational level","text":"ind-nhwa-1-02.md","meta":{"indicatorId":"1-02","module":"Module 1: Stock and flow","abbreviatedName":"Health worker density at subnational level","name":"Density of active health workers per 10 000 population at subnational level","numerator":"Number of active health workers in level 1 subnational administrative units","denominator":"Total population at subnational level","disaggregation":"By occupation","definition":"Number of active health workers per 10 000 population in the given subnational administrative unit.\nPreferably, the subnational unit should correspond to the place of work of health workers. The use\nof administrative units to the first subnational level is recommended (depending on the structure\nof administrative units and the size of subnational territories), without overlaps between the\nadministrative units. Examples of subnational administrative units include states, regions, provinces,\ncounties, and districts.","glossary":"Active health worker; Occupation; Subnational level","reportingFrequency":"Annual","reportingFrameworks":"UN SDG 3.c.1, Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM), SCORE for Health Data Technical Package (SCORE), Primary Health Care (PHC) Measurement Framework","dataSources":"Health workforce registry or database; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey); Professional council/chamber/association registers; Population census data; Health facility database (with location); United Nations Population Division","furtherInformation":"(5, 6, 9, 25, 45, 47-51)","dataElements":"de:cde-occupation; de:cde-employment-address; de:nhwa-m1-subnational-unit","programIndicatorId":"NHWA.1-02","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-024-01","pages":"53","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-03","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-03","kind":"indicator","title":"1-03 Health worker distribution by age group","text":"ind-nhwa-1-03.md","meta":{"indicatorId":"1-03","module":"Module 1: Stock and flow","abbreviatedName":"Health worker distribution by age group","name":"Percentage of active health workers in different age groups","numerator":"Number of active health workers in age group categories","denominator":"Total number of active health workers, defined in headcounts","disaggregation":"By occupation, by occupation and sex","definition":"Percentage of active health workers in the given age and sex category.\nThis indicator enables to create the population pyramid of health workers. Age groups considered are\nthe following: < 25, 25–34, 35–44, 45–54, 55–64, ≥ 65 years. Sex groups corresponds to male or female\nhealth workers.","glossary":"Active health worker; Age group; Sex; Occupation","reportingFrequency":"Annual","reportingFrameworks":"UN SDG 3.c.1, Global Strategic Directions for Nursing and Midwifery (SDNM), SCORE for Health Data Technical Package (SCORE)","dataSources":"Health workforce registry or database; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey); Professional council/chamber/association registers; Labour force surveys; Population census data","furtherInformation":"(6, 45, 48-51, 56)","dataElements":"de:cde-birth-history; de:cde-occupation; de:cde-sex","programIndicatorId":"NHWA.1-03","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-025-01","pages":"54","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-04","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-04","kind":"indicator","title":"1-04 Health worker distribution by sex","text":"ind-nhwa-1-04.md","meta":{"indicatorId":"1-04","module":"Module 1: Stock and flow","abbreviatedName":"Health worker distribution by sex","name":"Percentage of active health workers by sex","numerator":"Number of active health workers in sex categories","denominator":"Total number of active male and female health workers, defined in headcounts","disaggregation":"By occupation","definition":"Percentage of active health workers in the given sex category.\nSex group corresponds to male or female health workers.","glossary":"Active health worker; Occupation; Sex","reportingFrequency":"Annual","reportingFrameworks":"UN SDG 3.c.1, Global Strategic Directions for Nursing and Midwifery (SDNM), SCORE for Health Data Technical Package (SCORE)","dataSources":"Health workforce registry or database; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey); Labour force surveys; Population census data","furtherInformation":"(6, 45, 48-51, 54)","dataElements":"de:cde-occupation; de:cde-sex","programIndicatorId":"NHWA.1-04","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-026-01","pages":"55","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-05","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-05","kind":"indicator","title":"1-05 Health worker distribution by facility ownership","text":"ind-nhwa-1-05.md","meta":{"indicatorId":"1-05","module":"Module 1: Stock and flow","abbreviatedName":"Health worker distribution by facility ownership","name":"Percentage of active health workers employed by facility ownership","numerator":"Number of active health workers, defined in headcounts, working in facilities owned by the given institutional sector (public or private not-for-profit or private for-profit)","denominator":"Total number of active health workers, defined in headcounts","disaggregation":"By occupation","definition":"Percentage of active health workers employed by facility ownership (public, private not-for-profit,\nprivate for-profit).\nThe categories of facility ownership can be aligned to institutional sector definitions of the\nSystem of National Accounts (SNA 2008).","glossary":"Active health worker; Facility/institution ownership type; Institutional sector","reportingFrequency":"Annual","reportingFrameworks":"SCORE for Health Data Technical Package (SCORE)","dataSources":"Health workforce registry or database; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey); Labour force surveys; Census","furtherInformation":"(45, 49, 50, 54, 57)","dataElements":"de:cde-occupation; de:cde-employment-address; de:nhwa-m1-facility-ownership","programIndicatorId":"NHWA.1-05","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-027-01","pages":"56","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-06","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-06","kind":"indicator","title":"1-06 Health worker distribution by facility type","text":"ind-nhwa-1-06.md","meta":{"indicatorId":"1-06","module":"Module 1: Stock and flow","abbreviatedName":"Health worker distribution by facility type","name":"Percentage of active health workers employed by facility type","numerator":"Number of active health workers, defined in headcounts, working in a specific facility type","denominator":"Total number of active health workers, defined in headcounts","disaggregation":"By occupation","definition":"Percentage of active health workers employed in the given facility type. Health facility\ntypes are based on the classification of System of Health Accounts:\n• Hospitals (HP.1)\n• Residential long-term care facilities (HP.2)\n• Providers of ambulatory health care (HP.3)\n• Ancillary services (HP.4, including transportation, emergency rescue, laboratories and others)\n• Retailers (HP.5, including pharmacies)\n• Providers of preventive care (HP.6)","glossary":"Active health worker; Facility type; Occupation","reportingFrequency":"Annual","dataSources":"Health workforce registry or database; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey); Labour Force Surveys; Census","furtherInformation":"(51, 53, 58)","dataElements":"de:cde-occupation; de:cde-employment-address; de:nhwa-m1-facility-type","programIndicatorId":"NHWA.1-06","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-028-01","pages":"57","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-07","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-07","kind":"indicator","title":"1-07 Health worker distribution by place of birth","text":"ind-nhwa-1-07.md","meta":{"indicatorId":"1-07","module":"Module 1: Stock and flow","abbreviatedName":"Health worker distribution by place of birth","name":"Percentage of active health workers by their place of birth","numerator":"Number of active health workers by place of birth","denominator":"Total number of active health workers, defined in headcounts","disaggregation":"By occupation","definition":"Percentage of active health workers by their place of birth.\nPlace of birth is defined as national-born or foreign-born.\nThis indicator will capture the information on the health workers coming from abroad.","glossary":"Active health worker; Occupation; Place of birth","reportingFrequency":"Annual","reportingFrameworks":"WHO Global Code of Practice on the International Recruitment of Health Personnel, Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Health workforce registry or database; Professional council/chamber/association registers; Health facility data; Population census data","furtherInformation":"(31, 48, 49, 51, 59, 60)","dataElements":"de:cde-birth-history; de:cde-occupation; de:cde-citizenship-and-language","programIndicatorId":"NHWA.1-07","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-029-01","pages":"58","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-08","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-08","kind":"indicator","title":"1-08 Health worker distribution by place of training","text":"ind-nhwa-1-08.md","meta":{"indicatorId":"1-08","module":"Module 1: Stock and flow","abbreviatedName":"Health worker distribution by place of training","name":"Percentage of active health workers by their place of training","numerator":"Number of active health workers by place of training","denominator":"Total number of active health workers, defined in headcounts","disaggregation":"By occupation, by occupation and country of training among foreign-trained, by occupation and place of birth among foreign-trained","definition":"Percentage of active health workers by their place of training.\nPlace of training is defined as either domestic-trained, foreign-trained or unknown location of training.\nThe disaggregation by occupation and country of training is applicable to foreign-trained workers,\nand enables the monitoring of health worker migration by country of training. The disaggregation by\noccupation and place of birth is applicable to foreign-trained workers, and enables the monitoring of\nforeign-trained – national-born and foreign-trained – foreign-born workers.","glossary":"Active health worker; Occupation; Place of training","reportingFrequency":"Annual","reportingFrameworks":"WHO Global Code of Practice on the International Recruitment of Health Personnel, Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Health workforce registry or database; Professional council/chamber/association registers; Health facility data","furtherInformation":"(31, 48, 49, 61, 62)","dataElements":"de:cde-occupation; de:nhwa-m1-place-of-training","programIndicatorId":"NHWA.1-08","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-030-01","pages":"59","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-09","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-09","kind":"indicator","title":"1-09 Annual inflows of health workers","text":"ind-nhwa-1-09.md","meta":{"indicatorId":"1-09","module":"Module 1: Stock and flow","abbreviatedName":"Annual inflows of health workers","name":"Ratio of newly active health workers to the total stock of active health workers","numerator":"Number of newly active health workers","denominator":"Total number of active health workers, defined in headcounts","disaggregation":"By occupation, by occupation and place of training, by occupation, place of training and sex","definition":"Newly active health workers are those who started their activity in the given profession. In case data\nare available only for newly licensed health workers, the total number of licensed health workers\nshould be used as denominator regardless of availability of data on active health workers. For total\nnumber of active health workers, data at the middle or the end of the reference year should be used.\nDisaggregation by place of training (domestic-trained vs foreign-trained) enables to capture the\nhealth labour market dynamics of migration.","glossary":"Active health worker; Newly active health worker; Activity level; Place of training; Sex; Occupation","reportingFrequency":"Annual","reportingFrameworks":"Global Strategic Directions for Nursing and Midwifery (SDNM), SCORE for Health Data Technical Package (SCORE)","dataSources":"Ministry of Health database; Health workforce registry or database; Professional council/chamber/association registers; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey)","furtherInformation":"(45, 49-51)","dataElements":"de:cde-occupation; de:cde-sex; de:cde-employment-status; de:nhwa-m1-entry-date; de:nhwa-m1-place-of-training","programIndicatorId":"NHWA.1-09","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-031-01","pages":"60","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-10","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-10","kind":"indicator","title":"1-10 Annual outflows of health workers","text":"ind-nhwa-1-10.md","meta":{"indicatorId":"1-10","module":"Module 1: Stock and flow","abbreviatedName":"Annual outflows of health workers","name":"Ratio of active health workers leaving the health labour market to the total stock of active health workers","numerator":"Number of health workers who became inactive in the health labour market","denominator":"Total number of active health workers, defined in headcounts","disaggregation":"By occupation, by occupation and type of exit (voluntary vs involuntary), by occupation, type of exit and sex","definition":"Percentage of active health workers who became inactive in the health labour market\ndue to voluntary reason or involuntary reason\nThe disaggregation by type of exit has the following two categories:\n• Voluntary exit corresponds to the following situations: emigration, temporary leave, change of\nsector, early retirement or other voluntary reason. Only early retirement should be considered\nas voluntary exit; retirement at standard age is to be counted in the involuntary exit.\n• Involuntary exit corresponds to the following situations: death, retirement (excluding\nearly retirement), suspension from work, long-term illness or other involuntary reason.\nFor the total number of active health workers, data at the end of the previous year should be used.","glossary":"Active health worker; Activity level; Sex; Occupation","reportingFrequency":"Annual","reportingFrameworks":"SCORE for Health Data Technical Package (SCORE)","dataSources":"Health workforce registry or database; Professional council/chamber/association registers; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey); Data from pension and/or retirement administration units; Mortality records","furtherInformation":"(45, 47, 49-51, 53, 54, 63)","dataElements":"de:cde-occupation; de:cde-sex; de:cde-employment-status; de:nhwa-m1-exit","programIndicatorId":"NHWA.1-10","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-032-01","pages":"61","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-11","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-11","kind":"indicator","title":"1-11 Vacancy rate","text":"ind-nhwa-1-11.md","meta":{"indicatorId":"1-11","module":"Module 1: Stock and flow","abbreviatedName":"Vacancy rate","name":"Ratio of unfilled posts to total number of funded posts","numerator":"Number of funded full-time posts that have not been filled for at least twelve months","denominator":"Total number of funded full-time posts (filled and unfilled)","disaggregation":"By occupation","definition":"Ratio of unfilled posts to total number of posts.\nBy limiting the count of unfilled posts for at least twelve months, this indicator enables to\ndistinguish between a systematic job vacancy situation versus potential rapid turnover of staff.","glossary":"Occupation; Job vacancy; Subnational level; Vacancy rate","reportingFrequency":"Annual","reportingFrameworks":"Global Strategic Directions for Nursing and Midwifery (SDNM), SCORE for Health Data Technical Package (SCORE)","dataSources":"Labour force surveys; Health facility assessments; Employment offices and/or job agencies","furtherInformation":"(49, 53, 64)","programIndicatorId":"NHWA.1-11","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-033-01","pages":"62","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-1-12","@type":["smart-base:Indicator"],"label":"ind:nhwa-1-12","kind":"indicator","title":"1-12 Health worker distribution by type of contract","text":"ind-nhwa-1-12.md","meta":{"indicatorId":"1-12","module":"Module 1: Stock and flow","abbreviatedName":"Health worker distribution by type of contract","name":"Percentage of active health workers by their type of contract","numerator":"Number of active health workers in specific types of contracts (full-time vs part-time)","denominator":"Total number of active health workers, defined in headcounts","disaggregation":"By occupation","definition":"Percentage of active health workers in the given type of contract.\nType of contract are defined as either full-time or part-time.\n• Full-time workers are defined as employed or self-employed persons whose normal working hours\nin their main job correspond at least to the legal number of working hours per week, i.e. usually\nworking 30 hours per week or above.\n• Part-time workers are defined as employed or self-employed persons whose normal hours of\nwork are less than those of comparable full-time workers.","glossary":"Active health worker; Occupation; Contract type","reportingFrequency":"Annual","dataSources":"Facility database and/or surveys; Health workforce registry or database; Labour force surveys; Public service human resources and payroll administrations","furtherInformation":"(65-67)","dataElements":"de:cde-occupation; de:nhwa-m1-type-of-contract","programIndicatorId":"NHWA.1-12","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-034-01","pages":"63","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-2-01","@type":["smart-base:Indicator"],"label":"ind:nhwa-2-01","kind":"indicator","title":"2-01 Health workforce education and training capacity","text":"ind-nhwa-2-01.md","meta":{"indicatorId":"2-01","module":"Module 2: Education","abbreviatedName":"Health workforce education and training capacity","name":"Ratio of health workforce education and training capacity per 10 000 population","numerator":"Number of places in health education and training institutions","denominator":"Total population","disaggregation":"By health workforce education and training programme","definition":"The health workforce education and training capacity refers to the number of places or seats.\nThis indicator enables to estimate the availability of the training capacity and express it per\n10 000 population.\nTotal population as estimated in the World Population Prospects by the United Nations Population\nDivision. In case of other methodology used, WHO recalculates densities according to the UN\npopulation estimates in order to harmonize the densities and ensure comparability.","glossary":"Health workforce education and training capacity; Health workforce education and training programme; Health workforce education and training institution","reportingFrequency":"Annual","dataSources":"Ministry of Education; Data on education and training statistics; Education and training institutions; United Nations Population Division","furtherInformation":"(68)","programIndicatorId":"NHWA.2-01","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-036-01","pages":"66","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-2-02","@type":["smart-base:Indicator"],"label":"ind:nhwa-2-02","kind":"indicator","title":"2-02 Ratio of applications to education and training capacity","text":"ind-nhwa-2-02.md","meta":{"indicatorId":"2-02","module":"Module 2: Education","abbreviatedName":"Ratio of applications to education and training capacity","name":"Ratio of applications for health workforce education and training to the training capacity","numerator":"Number of applications for the first year of a health workforce education and training programme","denominator":"Total number of places available in the first year of a health workforce education and training programme","disaggregation":"By health workforce education and training programme, by health workforce education and training programme and sex","definition":"Applications for the first year of a health workforce education and training programme divided\nby the number of training places for this first year.","glossary":"Health workforce education and training place; Health workforce education and training programme; Applications; Sex","reportingFrequency":"Annual","reportingFrameworks":"Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Ministry of Education; Ministry of Higher Education; Databases on education and training statistics; education and training institutions","furtherInformation":"(51, 52, 68, 69)","programIndicatorId":"NHWA.2-02","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-037-01","pages":"67","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-2-03","@type":["smart-base:Indicator"],"label":"ind:nhwa-2-03","kind":"indicator","title":"2-03 Ratio of enrolments to application","text":"ind-nhwa-2-03.md","meta":{"indicatorId":"2-03","module":"Module 2: Education","abbreviatedName":"Ratio of enrolments to application","name":"Ratio of students enrolled in the first year of health workforce education and training programmes to applications for these programmes","numerator":"Total number of enrolments in the first year of a health workforce education and training programme","denominator":"Total number of applications for the first year of a health workforce education and training programme","disaggregation":"By health workforce education and training programme, by health workforce education and training programme and sex","definition":"Ratio of enrolment in health workforce education and training programmes to applications.","glossary":"Applications; Enrolments; Health workforce education and training programme; Sex","reportingFrequency":"Annual","reportingFrameworks":"Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Databases on education statistics; Education and training institutions","furtherInformation":"(6, 9, 68, 70)","programIndicatorId":"NHWA.2-03","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-038-01","pages":"68","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-2-04","@type":["smart-base:Indicator"],"label":"ind:nhwa-2-04","kind":"indicator","title":"2-04 Ratio of graduates to stock","text":"ind-nhwa-2-04.md","meta":{"indicatorId":"2-04","module":"Module 2: Education","abbreviatedName":"Ratio of graduates to stock","name":"Ratio of graduates of health workforce education and training programmes to the stock of active health workers","numerator":"Number of graduates from a cohort of a health workforce education and training programme","denominator":"Number of active health workers, defined in headcounts","disaggregation":"By health workforce education and training programme, by health workforce education and training programme and sex, by health workforce education and training programme and health education and training institution ownership (public/private)","definition":"This indicator aims to approach the graduation rate using data available on an annual basis. The exact\ngraduation rate can also be calculated from longitudinal information on students following cohorts\nof students. If such data are available, the graduation rate estimated from the most recent complete\ncohort can be reported. In addition to the total number of graduates, distribution of graduates by sex\nand by ownership enables to identify potential maldistribution and inequities.","glossary":"Graduate; Health workforce education and training programme; Sex; Student; Active health worker","reportingFrequency":"Annual","reportingFrameworks":"Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM), SCORE for Health Data Technical Package (SCORE)","dataSources":"Databases of health education and training institutions; Health workforce registry or database; Professional council/chamber/association registers","furtherInformation":"(6, 9, 45, 47)","dataElements":"de:cde-sex; de:nhwa-m2-qualification; de:nhwa-m2-training-institution","programIndicatorId":"NHWA.2-04","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-039-01","pages":"69","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-2-05","@type":["smart-base:Indicator"],"label":"ind:nhwa-2-05","kind":"indicator","title":"2-05 Duration of education and training","text":"ind-nhwa-2-05.md","meta":{"indicatorId":"2-05","module":"Module 2: Education","abbreviatedName":"Duration of education and training","name":"Duration of health workforce education and training programmes, in years","disaggregation":"By health workforce education and training programme","definition":"Duration of health workforce education and training is the number of years required to complete\na full curriculum for each health workforce education and training programme. This duration does\nnot include specializations or time to obtain additional, optional, certifications.","glossary":"Health workforce education and training programme; Duration of health workforce education and training","reportingFrequency":"Annual","reportingFrameworks":"Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Ministry of Education; Database on education and training statistics; Education and training institutions","furtherInformation":"(6, 51, 52, 69)","gaps":"numerator; denominator","programIndicatorId":"NHWA.2-05","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-040-01","pages":"70","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-2-06","@type":["smart-base:Indicator"],"label":"ind:nhwa-2-06","kind":"indicator","title":"2-06 Accreditation mechanisms for education and training institutions and their programmes","text":"ind-nhwa-2-06.md","meta":{"indicatorId":"2-06","module":"Module 2: Education","abbreviatedName":"Accreditation mechanisms for education and training institutions and their programmes","name":"Existence of national and/or subnational mechanisms for accreditation of health workforce education and training institutions and their programmes (Yes/Partial/No)","disaggregation":"By health workforce education and training programme","definition":"The following questions should guide a response to this indicator:\n• Have national and/or subnational mechanisms for accreditation of health workforce education\nand training institutions and their programmes been established?\n• Are national and/or subnational mechanisms for accreditation of health workforce education\nand training institutions and their programmes compulsory?\n• Are there national and/or subnational mechanisms for accreditation of health workforce\neducation and training institutions and their programmes that are not compulsory?\n• If established, do national and/or subnational mechanisms for accreditation of health workforce\neducation and training institutions and their programmes take into account national education\nplans for the health workforce?","glossary":"Accreditation; Health workforce education and training programme; Health workforce education and training institution","reportingFrequency":"Every three years","reportingFrameworks":"Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM), Primary Health Care (PHC) Measurement Framework","dataSources":"Ministry of Health; Ministries of Education, Higher Education or similar; National accreditation authorities; Legitimate bodies, statutory corporations; Professional council/chamber/association registers","furtherInformation":"(6, 9, 69, 71-73)","gaps":"numerator; denominator","programIndicatorId":"NHWA.2-06","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-041-01","pages":"71","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-2-07","@type":["smart-base:Indicator"],"label":"ind:nhwa-2-07","kind":"indicator","title":"2-07 Standards for education and training programmes","text":"ind-nhwa-2-07.md","meta":{"indicatorId":"2-07","module":"Module 2: Education","abbreviatedName":"Standards for education and training programmes","name":"Existence of standards for education and training programmes","disaggregation":"By health workforce education and training programme (for all but last sub-indicator 2-07.7)","definition":"This indicator is a composite of seven sub-indicators, see below. The response to these seven\nsub-indicators is aggregated as a score (see part II on methods) on a scale from 1 (nascent) to 5\n(sustainable).\nEach sub-indicator is a self-assessment of one aspect of standards on education and training\nprogrammes. To help answer these self-assessed sub-indicators, a series of guiding questions\nare provided.","glossary":"Health workforce education and training programme; Accreditation; Accreditation systems; Social accountability; Social determinants of health; Interprofessional education; Continuing professional development; Lifelong learning; Occupation; In-service training","reportingFrequency":"Every three years","reportingFrameworks":"Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Global Strategic Directions for Nursing and Midwifery (SDNM), Primary Health Care (PHC) Measurement Framework, Community Health Workers (CHWs)","dataSources":"Ministry of Health; Ministries of Education, Higher Education or similar; National accreditation authorities; Legitimate bodies, statutory corporations; Professional council/chamber/association registers; Ministries responsible for labour","furtherInformation":"(6, 9, 69, 71-73)","subIndicators":"2-07.1; 2-07.2; 2-07.3; 2-07.4; 2-07.5; 2-07.6; 2-07.7","gaps":"numerator; denominator","programIndicatorId":"NHWA.2-07","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-042-01","pages":"72-73","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-3-01","@type":["smart-base:Indicator"],"label":"ind:nhwa-3-01","kind":"indicator","title":"3-01 Expenditure on compensation of health workers","text":"ind-nhwa-3-01.md","meta":{"indicatorId":"3-01","module":"Module 3: Finance and expenditures","abbreviatedName":"Expenditure on compensation of health workers","name":"Total expenditure on compensation of health workers","disaggregation":"By public/private","definition":"Total expenditure expressed in US$ on compensation of health workers.\nIf possible, disaggregation by public or private sources for the compensation of health workers.\nSometimes information is only available for public expenditure on compensation of health workers.","glossary":"Active health worker; Remuneration","reportingFrequency":"Annual","reportingFrameworks":"Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Ministry of Health records; Ministry of Finance records; Public/social health insurance; System of health accounts","furtherInformation":"(6, 54, 58, 61)","dataElements":"de:nhwa-m3-employer-sector","gaps":"numerator; denominator","programIndicatorId":"NHWA.3-01","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-044-01","pages":"76","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-3-02","@type":["smart-base:Indicator"],"label":"ind:nhwa-3-02","kind":"indicator","title":"3-02 Entry-level wages and salaries","text":"ind-nhwa-3-02.md","meta":{"indicatorId":"3-02","module":"Module 3: Finance and expenditures","abbreviatedName":"Entry-level wages and salaries","name":"Average entry-level wage and salary excluding social contributions","disaggregation":"By occupation, by occupation and public/private","definition":"Average wage or salary in US$ received by health workers when entering the active health\nlabour market, excluding social contributions.\nDisaggregation by public vs private source is suggested, although often only the source from\nthe public sector is available.","glossary":"Active health worker; Occupation; Remuneration; Wage and salary","reportingFrequency":"Annual","reportingFrameworks":"Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Ministry of Health records; Ministry of Finance records; Payroll data; Income tax data; General labour force surveys; Specific health worker surveys","furtherInformation":"(6, 54, 58, 61)","dataElements":"de:cde-occupation; de:nhwa-m3-employer-sector; de:nhwa-m3-entry-salary-grade","gaps":"numerator; denominator","programIndicatorId":"NHWA.3-02","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-045-01","pages":"77","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-3-03","@type":["smart-base:Indicator"],"label":"ind:nhwa-3-03","kind":"indicator","title":"3-03 Total expenditure on health workforce education","text":"ind-nhwa-3-03.md","meta":{"indicatorId":"3-03","module":"Module 3: Finance and expenditures","abbreviatedName":"Total expenditure on health workforce education","name":"Total expenditure on health workforce pre-service education (current and capital)","disaggregation":"By health workforce education and training programme, by health workforce education and training programme and institution ownership (public/private)","definition":"Total expenditure in US$ on health workforce education (current and capital). The disaggregation\nenables to differentiate between public vs private sources and distribution across programmes.\nEducation here refers to pre-service education and does not include in-service education and training.","glossary":"Total public expenditure; Pre-service education","reportingFrequency":"Annual","reportingFrameworks":"Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Integrated Financial Management Information System; Ministry of Finance; Ministry of Health; Ministry of Education; Ministry of Defence (expenditure on military HWF education may fall under the Ministry of Defence budget); Education Management Information System: Ministry of (Higher) Education; ministry or other accredited bodies responsible for technical and vocational education and training; National Bureau of Statistics – Government financial statistics departments; System of Health Accounts; National Education Accounts","furtherInformation":"(6, 74-76)","dimension":"Financing of higher education","gaps":"numerator; denominator","programIndicatorId":"NHWA.3-03","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-046-01","pages":"78","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-3-04","@type":["smart-base:Indicator"],"label":"ind:nhwa-3-04","kind":"indicator","title":"3-04 Expenditure per graduate on health workforce education","text":"ind-nhwa-3-04.md","meta":{"indicatorId":"3-04","module":"Module 3: Finance and expenditures","abbreviatedName":"Expenditure per graduate on health workforce education","name":"Expenditure per graduate of health workforce education and training programme","numerator":"Total expenditure on health workforce education","denominator":"Total number of graduates from health workforce education and training programmes","disaggregation":"By health workforce education and training programme, by health workforce education and training programme and institution ownership (public/private)","definition":"Expenditure in US$ on health workforce education per graduate.\nThe disaggregation by programme enables to identify inequities across programmes.\nThe disaggregation by institution ownership enables to distinguish between publicly\nand privately owned education institutions.","glossary":"Health workforce education and training programme; Graduate; Total expenditure on health workforce education","reportingFrequency":"Annual","dataSources":"Integrated Financial Management Information System: Ministry of Finance; Ministry of Health; Ministry of Education; Ministry of Defence (expenditure on military HWF education may fall under this budget); Education Management Information System: Ministry of (Higher) Education; ministry or other accredited body responsible for technical and vocational education and training; National Bureau of Statistics – Government financial statistics departments; System of Health Accounts; National Education Accounts","furtherInformation":"(75, 76)","dimension":"Education expenditure","programIndicatorId":"NHWA.3-04","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-047-01","pages":"79","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-3-05","@type":["smart-base:Indicator"],"label":"ind:nhwa-3-05","kind":"indicator","title":"3-05 Average tuition fee per student","text":"ind-nhwa-3-05.md","meta":{"indicatorId":"3-05","module":"Module 3: Finance and expenditures","abbreviatedName":"Average tuition fee per student","name":"Average annual tuition fee per student enrolled in health workforce education and training","numerator":"Total tuition fees paid by students enrolled in health workforce education and training programmes for a given year","denominator":"Total number of students enrolled in health workforce education and training programmes","disaggregation":"By health workforce education and training programme","definition":"Average tuition fee in US$ per student enrolled in health workforce education and training per year,\nby health workforce education and training programme.\nWhenever possible, this indicator should exclude students exonerated from paying tuition fees.","glossary":"Health workforce education and training programme; Student","reportingFrequency":"Annual","dataSources":"Ministry of Finance; Ministry of Education; Databases on education statistics; Education and training institutions","furtherInformation":"(75, 77)","programIndicatorId":"NHWA.3-05","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-048-01","pages":"80","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-4-01","@type":["smart-base:Indicator"],"label":"ind:nhwa-4-01","kind":"indicator","title":"4-01 Labour regulations and policies for health workforce","text":"ind-nhwa-4-01.md","meta":{"indicatorId":"4-01","module":"Module 4: Working conditions, governance and leadership","abbreviatedName":"Labour regulations and policies for health workforce","name":"Existence of labour regulations and policies on the employment characteristics, protection and working conditions of the health workforce","definition":"This indicator is a composite of twelve sub-indicators, see below. The response to these twelve\nsub-indicators is aggregated as a score (see part II on methods) on a scale from 1 (nascent) to 5\n(sustainable).\nEach sub-indicator is a self-assessment of one aspect of labour regulation and policies, primarily\nto protect and safeguard health and care workers. To help answer these self-assessed sub-indicators,\na series of guiding questions are provided.","glossary":"Status in employment; Occupation; Community health workers; Childcare support; Continuing professional development; In-service training; Leave entitlements to care for sick family members; Parental leave; Dual practice","reportingFrequency":"Every three years","reportingFrameworks":"Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM), Global Health and Care Worker Compact, Community Health Workers (CHWs)","dataSources":"Employment laws, policies and regulations; Social security records; Government or legislative records; Survey among country experts or informants; Policy and strategic documents of governments and competent authorities","furtherInformation":"(6, 78-85)","subIndicators":"4-01.1; 4-01.2; 4-01.3; 4-01.4; 4-01.5; 4-01.6; 4-01.7; 4-01.8; 4-01.9; 4-01.10; 4-01.11; 4-01.12","gaps":"numerator; denominator; disaggregation","programIndicatorId":"NHWA.4-01","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-050-01","pages":"82-84","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-4-02","@type":["smart-base:Indicator"],"label":"ind:nhwa-4-02","kind":"indicator","title":"4-02 Health workforce governance and leadership capacity","text":"ind-nhwa-4-02.md","meta":{"indicatorId":"4-02","module":"Module 4: Working conditions, governance and leadership","abbreviatedName":"Health workforce governance and leadership capacity","name":"Existence of health workforce governance and leadership capacity at national and/or subnational levels","definition":"This indicator is a composite of five sub-indicators, see below. The response to these five\nsub-indicators is aggregated as a score (see part II on methods) on a scale from 1 (nascent)\nto 5 (sustainable).\nEach sub-indicator is a self-assessment of one aspect of countries’ governance and leadership\ncapacity vis-à-vis of health and care workers. To help answer these self-assessed sub-indicators,\na series of guiding questions are provided.","glossary":"Occupation; Health workforce planning; Lifelong learning; Continuing professional development; In-service training","reportingFrequency":"Every three years","reportingFrameworks":"Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM)","dataSources":"Ministry of Health, Education, Labour; Regional and/or subnational ministries of health and education; Institutions or units responsible for policies on health workforce; Relevant ministries according to the national government structure and constitutional arrangements/ level of devolution; Educational institutions; Health facilities","furtherInformation":"(6, 9, 52, 53, 63, 86-94)","subIndicators":"4-02.1; 4-02.2; 4-02.3; 4-02.4; 4-02.5","gaps":"numerator; denominator; disaggregation","programIndicatorId":"NHWA.4-02","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-051-01","pages":"85-86","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-4-03","@type":["smart-base:Indicator"],"label":"ind:nhwa-4-03","kind":"indicator","title":"4-03 Share of women in leadership role","text":"ind-nhwa-4-03.md","meta":{"indicatorId":"4-03","module":"Module 4: Working conditions, governance and leadership","abbreviatedName":"Share of women in leadership role","name":"Share of women in senior management positions in the Ministry of Health","numerator":"Number of women in leadership roles in the Ministry of Health, defined in headcounts","denominator":"Total number of men and women in leadership roles in the Ministry of Health, defined in headcounts","definition":"Share of women, expressed as a percentage, of women in senior management positions in\nthe Ministry of Health.\nTo monitor and report on this indicator, it is advised to count all individuals at director-level\nor equivalent positions within the Ministry of Health. Using the organigram of the Ministry of\nHealth, focusing on the senior positions, should be sufficient to estimate this indicator. Alternative\napproaches could be based on the count of men and women in delegations participating to the\nannual World Health Assemblies.","glossary":"Active health worker; Leadership role; Gender","reportingFrequency":"Every three years","dataSources":"Ministry of Health organigram or official documents","furtherInformation":"(21, 95, 96)","dataElements":"de:nhwa-m4-leadership-position","gaps":"disaggregation","programIndicatorId":"NHWA.4-03","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-052-01","pages":"87","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-4-04","@type":["smart-base:Indicator"],"label":"ind:nhwa-4-04","kind":"indicator","title":"4-04 International Health Regulations implementation capacity","text":"ind-nhwa-4-04.md","meta":{"indicatorId":"4-04","module":"Module 4: Working conditions, governance and leadership","abbreviatedName":"International Health Regulations implementation capacity","name":"Availability of human resources to implement International Health Regulations core capacity requirements (None/Limited/Developed/Demonstrated/ Sustainable)","definition":"This indicator is based on indicator D3.2 of the Joint External Evaluation (JEE) tool, third edition\n(which is similar to indicator C6.1 in State Party Self-assessment Annual Reporting (SAPR) tool),\nand it uses the following (capability) items:\nNo capacity (level 1)\nCountry does not have appropriate human resources capacity in relevant sectors required\nto detect, assess, notify, report and respond to events according to IHR provisions\nLimited capacity (level 2)\nAppropriate human resources are available in some relevant sectors at the national level\nto detect, assess, notify, report and respond to events according to IHR provisions\nDeveloped capacity (level 3)\nAppropriate human resources are available in all relevant sectors at national and intermediate\nlevels to detect, assess, notify, report and respond to events according to IHR provisions\nDemonstrated capacity (level 4)\nHuman resources are available as required in all relevant sectors at the national, intermediate\nand primary public health levels to detect, assess, notify, report and respond to events according\nto IHR provisions\nSustainable capacity (level 5)\nCountry has documented policies or procedures for sustainable appropriate human resources in all\nrelevant sectors to detect, assess, notify, report and respond to events according to IHR provisions,\nthat are exercised (as applicable), reviewed, evaluated and updated on a regular basis, and country\nmay assist other countries in planning and developing human resources for IHR implementation,\nto the extent possible","glossary":"International Health Regulations; Public health workforce","reportingFrequency":"Every three years","reportingFrameworks":"Joint External Evaluation (JEE), State Party Self-Assessment Annual Reporting Tool (SPAR)","dataSources":"Ministry of Health; Public health institutions","furtherInformation":"(97, 98)","gaps":"numerator; denominator; disaggregation","programIndicatorId":"NHWA.4-04","source":{"library":"who-iris:9789240081291-eng","node":"library/9789240081291-eng/blocks/indicator-sec-052-02","pages":"88","method":"indicator-extraction","verbatim":true},"status":"draft"},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-hrh/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-hrh/blocks/ind-nhwa-4-05","@type":["smart-base:Indicator"],"label":"ind:nhwa-4-05","kind":"indicator","title":"4-05 National capacity to monitor key metrics for health workforce planning and global monitoring frameworks","text":"ind-nhwa-4-05.md","meta":{"indicatorId":"4-05","module":"Module 4: Working conditions, governance and leadership","abbreviatedName":"National capacity to monitor key metrics for health workforce planning and global monitoring frameworks","name":"Capacity of national human resources for health information systems to monitor key metrics relevant for national health workforce planning and policy-making and for global monitoring frameworks","definition":"This indicator is a composite of nine sub-indicators, see below. The response to these nine\nsub-indicators is aggregated as a score (see part II on methods) on a scale from 1 (nascent)\nto 5 (sustainable).\nEach sub-indicator is a self-assessment of one aspect of the capacity of the national human\nresources for health information system (HRHIS) or other mechanisms to report on key metrics\nthat are relevant for national health workforce planning and policy-making as well as for global\nmonitoring frameworks. To help answer some of these self-assessed sub-indicators, guiding\nquestions are provided.","glossary":"International Health Regulations; Subnational level; Active health worker; Occupation; Remuneration; Status in employment; Gender","reportingFrequency":"Annual","reportingFrameworks":"Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM), SCORE for Health Data Technical Package (SCORE)","dataSources":"Ministry of Health and regional ministries of health; Professional chambers; Institutions or units responsible for monitoring, or for policies on the health workforce; Ministry of Labour; National Statistical Office; National Focal Point for WHO Global Code of Practice; Ministry of Health and subnational ministries of health; Institutions collecting health workforce data","furtherInformation":"(6, 9, 31, 51, 63, 98-100)","subIndicators":"4-05.1; 4-05.2; 4-05.3; 4-05.4; 4-05.5; 4-05.6; 4-05.7; 4-05.8; 4-05.9","gaps":"numerator; denominator; disaggregation","programI