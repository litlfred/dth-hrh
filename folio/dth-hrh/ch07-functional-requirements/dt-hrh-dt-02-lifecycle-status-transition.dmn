<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_HRH_DT_02"
             name="HRH-DT-02 Lifecycle status transition and licence standing"
             namespace="https://litlfred.github.io/dth-hrh/dmn/hrh-dt-02">

  <decision id="Decision_HRH_DT_02" name="Health worker lifecycle and licence status transition">
    <description>Determines the resulting registration/licence status and record retention action when a lifecycle event occurs. Source passages: prose:ch07-lifecycle-management (Section 7.3), freq:FR-LC-01 (Record lifecycle events: registration, licence renewal, employment change, suspension, retirement), freq:FR-LC-02 (Preserve historical states and never overwrite prior records), scen:renew-licence (Section 5.2). Threshold provenance: qualitative states only from source text; renewal period lengths and CPD credit thresholds are country-configured and not hardcoded.</description>

    <decisionTable id="DecisionTable_HRH_DT_02" hitPolicy="FIRST">

      <input id="Input_DT02_Current" label="Current registration/licence status (freq:FR-LC-01)">
        <inputExpression id="InputExpr_DT02_Current" typeRef="string">
          <text>currentStatus</text>
        </inputExpression>
      </input>

      <input id="Input_DT02_Event" label="Reported lifecycle event (freq:FR-LC-01)">
        <inputExpression id="InputExpr_DT02_Event" typeRef="string">
          <text>lifecycleEvent</text>
        </inputExpression>
      </input>

      <input id="Input_DT02_Evidence" label="CPD or regulatory evidence status (freq:FR-LC-01, scen:renew-licence)">
        <inputExpression id="InputExpr_DT02_Evidence" typeRef="string">
          <text>evidenceStatus</text>
        </inputExpression>
      </input>

      <output id="Output_DT02_NewStatus" name="targetStatus" label="Resulting registry status (freq:FR-LC-01)" typeRef="string"/>
      <output id="Output_DT02_History" name="historyAction" label="Historical state action (freq:FR-LC-02)" typeRef="string"/>

      <!-- Rule 1: Death reported and confirmed -->
      <rule id="Rule_DT02_01">
        <description>Confirmed death of a health worker: transition status to deceased and preserve complete historical record (freq:FR-LC-01, freq:FR-LC-02, Section 4.3).</description>
        <inputEntry id="IE_DT02_01_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT02_01_2"><text>"death"</text></inputEntry>
        <inputEntry id="IE_DT02_01_3"><text>"confirmed"</text></inputEntry>
        <outputEntry id="OE_DT02_01_1"><text>"deceased"</text></outputEntry>
        <outputEntry id="OE_DT02_01_2"><text>"append-state-preserve-history"</text></outputEntry>
      </rule>

      <!-- Rule 2: Disciplinary revocation -->
      <rule id="Rule_DT02_02">
        <description>Regulatory authority issues a revocation order: transition status to revoked and preserve prior active/suspended history (freq:FR-LC-01, freq:FR-LC-02, Section 7.3).</description>
        <inputEntry id="IE_DT02_02_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT02_02_2"><text>"revocation"</text></inputEntry>
        <inputEntry id="IE_DT02_02_3"><text>"confirmed"</text></inputEntry>
        <outputEntry id="OE_DT02_02_1"><text>"revoked"</text></outputEntry>
        <outputEntry id="OE_DT02_02_2"><text>"append-state-preserve-history"</text></outputEntry>
      </rule>

      <!-- Rule 3: Disciplinary suspension -->
      <rule id="Rule_DT02_03">
        <description>Regulatory authority records a temporary suspension: transition status to suspended and retain prior state history (freq:FR-LC-01, freq:FR-LC-02, Section 5.2, Section 7.3).</description>
        <inputEntry id="IE_DT02_03_1"><text>"active", "lapsed"</text></inputEntry>
        <inputEntry id="IE_DT02_03_2"><text>"suspension"</text></inputEntry>
        <inputEntry id="IE_DT02_03_3"><text>"confirmed"</text></inputEntry>
        <outputEntry id="OE_DT02_03_1"><text>"suspended"</text></outputEntry>
        <outputEntry id="OE_DT02_03_2"><text>"append-state-preserve-history"</text></outputEntry>
      </rule>

      <!-- Rule 4: Retirement or emigration from active workforce -->
      <rule id="Rule_DT02_04">
        <description>Health worker retires or exits the national active workforce: transition status to retired-or-exited while retaining historical record for workforce analytics (freq:FR-LC-01, freq:FR-LC-02, Section 4.3).</description>
        <inputEntry id="IE_DT02_04_1"><text>"active", "lapsed"</text></inputEntry>
        <inputEntry id="IE_DT02_04_2"><text>"retirement", "emigration"</text></inputEntry>
        <inputEntry id="IE_DT02_04_3"><text>"confirmed"</text></inputEntry>
        <outputEntry id="OE_DT02_04_1"><text>"retired-or-exited"</text></outputEntry>
        <outputEntry id="OE_DT02_04_2"><text>"append-state-preserve-history"</text></outputEntry>
      </rule>

      <!-- Rule 5: Licence renewal with satisfied CPD and good standing -->
      <rule id="Rule_DT02_05">
        <description>Licence renewal submitted with confirmed continuing professional development (CPD) and regulatory requirements: keep or restore active status and append new validity period (freq:FR-LC-01, freq:FR-LC-02, scen:renew-licence).</description>
        <inputEntry id="IE_DT02_05_1"><text>"active", "lapsed"</text></inputEntry>
        <inputEntry id="IE_DT02_05_2"><text>"licence-renewal"</text></inputEntry>
        <inputEntry id="IE_DT02_05_3"><text>"confirmed"</text></inputEntry>
        <outputEntry id="OE_DT02_05_1"><text>"active"</text></outputEntry>
        <outputEntry id="OE_DT02_05_2"><text>"append-state-preserve-history"</text></outputEntry>
      </rule>

      <!-- Rule 6: Licence expiry without completed renewal -->
      <rule id="Rule_DT02_06">
        <description>Licence validity period expires without confirmed renewal: transition status to lapsed and preserve prior active period (freq:FR-LC-01, freq:FR-LC-02, Section 7.3).</description>
        <inputEntry id="IE_DT02_06_1"><text>"active"</text></inputEntry>
        <inputEntry id="IE_DT02_06_2"><text>"licence-expiry", "licence-renewal"</text></inputEntry>
        <inputEntry id="IE_DT02_06_3"><text>"deficient", "expired"</text></inputEntry>
        <outputEntry id="OE_DT02_06_1"><text>"lapsed"</text></outputEntry>
        <outputEntry id="OE_DT02_06_2"><text>"append-state-preserve-history"</text></outputEntry>
      </rule>

      <!-- Rule 7: Reinstatement from suspension -->
      <rule id="Rule_DT02_07">
        <description>Suspended practitioner satisfies regulatory reinstatement conditions: transition status back to active and append reinstatement event to history (freq:FR-LC-01, freq:FR-LC-02, Section 5.1).</description>
        <inputEntry id="IE_DT02_07_1"><text>"suspended"</text></inputEntry>
        <inputEntry id="IE_DT02_07_2"><text>"reinstatement"</text></inputEntry>
        <inputEntry id="IE_DT02_07_3"><text>"confirmed"</text></inputEntry>
        <outputEntry id="OE_DT02_07_1"><text>"active"</text></outputEntry>
        <outputEntry id="OE_DT02_07_2"><text>"append-state-preserve-history"</text></outputEntry>
      </rule>

      <!-- Rule 8: Employment or place-of-practice update for an active worker -->
      <rule id="Rule_DT02_08">
        <description>Confirmed change of employer, position, facility posting or emergency deployment for an active practitioner: maintain active status and append new affiliation state without overwriting prior postings (freq:FR-LC-01, freq:FR-LC-02, scen:update-employment).</description>
        <inputEntry id="IE_DT02_08_1"><text>"active"</text></inputEntry>
        <inputEntry id="IE_DT02_08_2"><text>"employment-update", "emergency-deployment"</text></inputEntry>
        <inputEntry id="IE_DT02_08_3"><text>"confirmed"</text></inputEntry>
        <outputEntry id="OE_DT02_08_1"><text>"active"</text></outputEntry>
        <outputEntry id="OE_DT02_08_2"><text>"append-state-preserve-history"</text></outputEntry>
      </rule>

      <!-- Rule 9: Third state (pending / unknown evidence) -->
      <rule id="Rule_DT02_09">
        <description>Third state: lifecycle event evidence is pending or unknown — hold transition for regulator verification and keep existing status unchanged (freq:FR-LC-01, freq:FR-LC-02).</description>
        <inputEntry id="IE_DT02_09_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT02_09_2"><text>-</text></inputEntry>
        <inputEntry id="IE_DT02_09_3"><text>"pending", "unknown"</text></inputEntry>
        <outputEntry id="OE_DT02_09_1"><text>"hold-pending-verification"</text></outputEntry>
        <outputEntry id="OE_DT02_09_2"><text>"log-pending-review-no-overwrite"</text></outputEntry>
      </rule>

      <!-- Rule 10: Catch-all fallback -->
      <rule id="Rule_DT02_10">
        <description>Catch-all rule: any unhandled transition combination is held for manual regulatory review without overwriting historical records.</description>
        <inputEntry id="IE_DT02_10_1"><text>-</text></inputEntry>
        <inputEntry id="IE_DT02_10_2"><text>-</text></inputEntry>
        <inputEntry id="IE_DT02_10_3"><text>-</text></inputEntry>
        <outputEntry id="OE_DT02_10_1"><text>"hold-pending-verification"</text></outputEntry>
        <outputEntry id="OE_DT02_10_2"><text>"log-pending-review-no-overwrite"</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>
</definitions>
