<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_HRH_BP_02"
                  targetNamespace="https://litlfred.github.io/dth-hrh/bpmn">

  <bpmn:resource id="pers:health-worker" name="Health worker"/>
  <bpmn:resource id="pers:training-institution-registrar" name="Training institution registrar"/>
  <bpmn:resource id="pers:system-national-id" name="National identity system"/>
  <bpmn:resource id="pers:registration-officer" name="Registration officer (regulatory body)"/>

  <bpmn:collaboration id="Collab_HRH_BP_02">
    <bpmn:participant id="Pool_HRH_BP_02" name="HRH-BP-02 Register and license a new graduate" processRef="HRH_BP_02"/>
  </bpmn:collaboration>

  <bpmn:process id="HRH_BP_02" name="Register and license a new graduate (HRH-BP-02)" isExecutable="false">
    <bpmn:documentation>Registers and licenses a newly graduated health worker by verifying pre-service qualification with the training institution, checking foundational identity and deduplication rules, and issuing an authoritative registration and licence to practise.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_HRH_BP_02">
      <bpmn:lane id="Lane_BP02_HealthWorker" name="Health worker" partitionElementRef="pers:health-worker">
        <bpmn:flowNodeRef>Start_BP02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP02_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP02_07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_RegistrationOfficer" name="Registration officer (regulatory body)" partitionElementRef="pers:registration-officer">
        <bpmn:flowNodeRef>Task_BP02_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BP02_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP02_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP02_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BP02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_TrainingRegistrar" name="Training institution registrar" partitionElementRef="pers:training-institution-registrar">
        <bpmn:flowNodeRef>Task_BP02_02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_NationalId" name="National identity system" partitionElementRef="pers:system-national-id">
        <bpmn:flowNodeRef>Task_BP02_03</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BP02" name="Graduation completed">
      <bpmn:outgoing>Flow_BP02_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_BP02_01" name="Submit registration and licence application">
      <bpmn:incoming>Flow_BP02_01</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_02" name="Attest graduation and qualification at source">
      <bpmn:incoming>Flow_BP02_02</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BP02_03" name="Verify foundational identity where lawful">
      <bpmn:incoming>Flow_BP02_03</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_BP02_04" name="Evaluate registration eligibility and duplicate check">
      <bpmn:incoming>Flow_BP02_04</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_05</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_BP02_Eligible" name="Outcome?">
      <bpmn:incoming>Flow_BP02_05</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_BP02_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BP02_05" name="Issue HWR ID, registration and licence credential">
      <bpmn:incoming>Flow_BP02_06</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_06" name="Queue for manual review or notify rejection">
      <bpmn:incoming>Flow_BP02_07</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_07" name="Receive verifiable registration and licence">
      <bpmn:incoming>Flow_BP02_08</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BP02" name="Application completed">
      <bpmn:incoming>Flow_BP02_09</bpmn:incoming>
      <bpmn:incoming>Flow_BP02_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_BP02_01" sourceRef="Start_BP02" targetRef="Task_BP02_01"/>
    <bpmn:sequenceFlow id="Flow_BP02_02" sourceRef="Task_BP02_01" targetRef="Task_BP02_02"/>
    <bpmn:sequenceFlow id="Flow_BP02_03" sourceRef="Task_BP02_02" targetRef="Task_BP02_03"/>
    <bpmn:sequenceFlow id="Flow_BP02_04" sourceRef="Task_BP02_03" targetRef="Task_BP02_04"/>
    <bpmn:sequenceFlow id="Flow_BP02_05" sourceRef="Task_BP02_04" targetRef="Gw_BP02_Eligible"/>
    <bpmn:sequenceFlow id="Flow_BP02_06" sourceRef="Gw_BP02_Eligible" targetRef="Task_BP02_05" name="Eligible"/>
    <bpmn:sequenceFlow id="Flow_BP02_07" sourceRef="Gw_BP02_Eligible" targetRef="Task_BP02_06" name="Hold / reject"/>
    <bpmn:sequenceFlow id="Flow_BP02_08" sourceRef="Task_BP02_05" targetRef="Task_BP02_07"/>
    <bpmn:sequenceFlow id="Flow_BP02_09" sourceRef="Task_BP02_07" targetRef="End_BP02"/>
    <bpmn:sequenceFlow id="Flow_BP02_10" sourceRef="Task_BP02_06" targetRef="End_BP02"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_HRH_BP_02">
    <bpmndi:BPMNPlane id="BPMNPlane_HRH_BP_02" bpmnElement="Collab_HRH_BP_02">
      <bpmndi:BPMNShape id="Pool_HRH_BP_02_di" bpmnElement="Pool_HRH_BP_02" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1180" height="660" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP02_HealthWorker_di" bpmnElement="Lane_BP02_HealthWorker" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1150" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP02_RegistrationOfficer_di" bpmnElement="Lane_BP02_RegistrationOfficer" isHorizontal="true">
        <dc:Bounds x="150" y="230" width="1150" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP02_TrainingRegistrar_di" bpmnElement="Lane_BP02_TrainingRegistrar" isHorizontal="true">
        <dc:Bounds x="150" y="450" width="1150" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP02_NationalId_di" bpmnElement="Lane_BP02_NationalId" isHorizontal="true">
        <dc:Bounds x="150" y="590" width="1150" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_BP02_di" bpmnElement="Start_BP02">
        <dc:Bounds x="205" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="186" y="177" width="75" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP02_01_di" bpmnElement="Task_BP02_01">
        <dc:Bounds x="290" y="121" width="170" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP02_02_di" bpmnElement="Task_BP02_02">
        <dc:Bounds x="290" y="486" width="170" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP02_03_di" bpmnElement="Task_BP02_03">
        <dc:Bounds x="290" y="631" width="170" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP02_04_di" bpmnElement="Task_BP02_04">
        <dc:Bounds x="520" y="306" width="170" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_BP02_Eligible_di" bpmnElement="Gw_BP02_Eligible" isMarkerVisible="true">
        <dc:Bounds x="750" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="285" width="70" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP02_05_di" bpmnElement="Task_BP02_05">
        <dc:Bounds x="910" y="246" width="170" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP02_06_di" bpmnElement="Task_BP02_06">
        <dc:Bounds x="910" y="356" width="170" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP02_07_di" bpmnElement="Task_BP02_07">
        <dc:Bounds x="910" y="121" width="170" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_BP02_di" bpmnElement="End_BP02">
        <dc:Bounds x="1160" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1141" y="362" width="74" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_BP02_01_di" bpmnElement="Flow_BP02_01">
        <di:waypoint x="241" y="155" />
        <di:waypoint x="290" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP02_02_di" bpmnElement="Flow_BP02_02">
        <di:waypoint x="375" y="189" />
        <di:waypoint x="375" y="486" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP02_03_di" bpmnElement="Flow_BP02_03">
        <di:waypoint x="375" y="554" />
        <di:waypoint x="375" y="631" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP02_04_di" bpmnElement="Flow_BP02_04">
        <di:waypoint x="460" y="665" />
        <di:waypoint x="490" y="665" />
        <di:waypoint x="490" y="340" />
        <di:waypoint x="520" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP02_05_di" bpmnElement="Flow_BP02_05">
