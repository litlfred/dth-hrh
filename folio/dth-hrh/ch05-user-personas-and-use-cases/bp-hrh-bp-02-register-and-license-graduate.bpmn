        <di:waypoint x="750" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP02_06_di" bpmnElement="Flow_BP02_06">
        <di:waypoint x="775" y="315" />
