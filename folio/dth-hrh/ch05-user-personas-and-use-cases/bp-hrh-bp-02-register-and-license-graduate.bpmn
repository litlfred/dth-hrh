      <bpmndi:BPMNEdge id="Flow_BP02_09_di" bpmnElement="Flow_BP02_09">
        <di:waypoint x="1080" y="155" />
        <di:waypoint x="1178" y="155" />
        <di:waypoint x="1178" y="322" />
