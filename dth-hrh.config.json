{
  "contentType": "document",
  "adapter": "document",
  "adapterModule": "./folio-assistant-core/adapters/document/index.ts",
  "dependencies": {
    "folioAssistant": [
      {
        "name": "folio-assistant-core",
        "path": "folio-assistant-core"
      },
      {
        "name": "smart-base",
        "path": "smart-base"
      }
    ]
  },
  "feedbackDir": ".folio-feedback",
  "skills": ".claude/skills/local",
  "viewer": {
    "dir": "cat-harness-tools/viewer",
    "port": 8080
  },
  "readme": {
    "linkStyle": "blob",
    "publishRef": "gh-pages"
  },
  "site": {
    "build": {
      "sourceSteps": [
        "site:document",
        "site:wg-comment",
        "site:library",
        "site:review-sheet",
        "site:glossary",
        "site:archimate",
        "site:context"
      ],
      "siteSteps": [
        "site:node-kinds",
        "site:export"
      ],
      "pre": [
        "check:dth-glossary",
        "check:review-anchors",
        "check:kg-blocks",
        "check:library-kg",
        "check:page-furniture"
      ]
    }
  },
  "_site_comment": "`site:context` builds the JSON-LD context the KG nodes name (ns/context/v1.jsonld under iriBase) into the site, so it is published with it (cat-harness-tools#1052); nothing else writes it, so nothing is kept."
}
