<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_HRH_BP_06"
                  targetNamespace="https://litlfred.github.io/dth-hrh/bpmn">

  <bpmn:resource id="pers:registry-governance-body" name="Registry governance body (steering committee)"/>
  <bpmn:resource id="pers:registry-custodian" name="Registry operator and data custodian"/>
  <bpmn:resource id="pers:health-worker" name="Health worker"/>
  <bpmn:resource id="pers:registration-officer" name="Registration officer (regulatory body)"/>

  <bpmn:collaboration id="Collab_HRH_BP_06">
    <bpmn:participant id="Pool_HRH_BP_06" name="HRH-BP-06 Registry governance, data-sharing approval and record correction" processRef="HRH_BP_06"/>
  </bpmn:collaboration>

  <bpmn:process id="HRH_BP_06" name="Registry governance, data-sharing approval and record correction (HRH-BP-06)" isExecutable="false">
    <bpmn:documentation>Governs inter-institutional data-sharing agreements and access tiers through the multi-stakeholder steering committee, enforces routine data quality and deduplication audits through the registry custodian, and resolves health worker record-correction requests with the authoritative source.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_HRH_BP_06">
      <bpmn:lane id="Lane_BP06_GovernanceBody" name="Registry governance body (steering committee)" partitionElementRef="pers:registry-governance-body">
        <bpmn:flowNodeRef>Start_BP06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP06_01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP06_Custodian" name="Registry operator and data custodian" partitionElementRef="pers:registry-custodian">
        <bpmn:flowNodeRef>Task_BP06_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP06_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP06_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BP06</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP06_HealthWorker" name="Health worker" partitionElementRef="pers:health-worker">
        <bpmn:flowNodeRef>Task_BP06_03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP06_RegistrationOfficer" name="Registration officer (regulatory body)" partitionElementRef="pers:registration-officer">
        <bpmn:flowNodeRef>Gw_BP06_Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP06_05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BP06" name="Policy review, audit or correction request">
      <bpmn:outgoing>Flow_BP06_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_BP06_01" name="Approve data-sharing agreement and tiered disclosure policy">
      <bpmn:incoming>Flow_BP06_01</bpmn:incoming>
      <bpmn:outgoing>Flow_BP06_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP06_02" name="Configure access controls, audit logs and quality/duplicate checks">
      <bpmn:incoming>Flow_BP06_02</bpmn:incoming>
      <bpmn:outgoing>Flow_BP06_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP06_03" name="Inspect own registry record and submit correction request">
      <bpmn:incoming>Flow_BP06_03</bpmn:incoming>
      <bpmn:outgoing>Flow_BP06_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP06_04" name="Route dispute to authoritative source custodian and log provenance">
      <bpmn:incoming>Flow_BP06_04</bpmn:incoming>
      <bpmn:outgoing>Flow_BP06_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_BP06_Verified" name="Source verified?">
      <bpmn:incoming>Flow_BP06_05</bpmn:incoming>
      <bpmn:outgoing>Flow_BP06_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_BP06_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BP06_05" name="Adjudicate and update authoritative field with audit trail">
      <bpmn:incoming>Flow_BP06_06</bpmn:incoming>
      <bpmn:outgoing>Flow_BP06_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP06_06" name="Record rejection reason and notify health worker">
      <bpmn:incoming>Flow_BP06_07</bpmn:incoming>
      <bpmn:outgoing>Flow_BP06_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BP06" name="Stewardship action logged">
      <bpmn:incoming>Flow_BP06_08</bpmn:incoming>
      <bpmn:incoming>Flow_BP06_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_BP06_01" sourceRef="Start_BP06" targetRef="Task_BP06_01"/>
    <bpmn:sequenceFlow id="Flow_BP06_02" sourceRef="Task_BP06_01" targetRef="Task_BP06_02"/>
    <bpmn:sequenceFlow id="Flow_BP06_03" sourceRef="Task_BP06_02" targetRef="Task_BP06_03"/>
    <bpmn:sequenceFlow id="Flow_BP06_04" sourceRef="Task_BP06_03" targetRef="Task_BP06_04"/>
    <bpmn:sequenceFlow id="Flow_BP06_05" sourceRef="Task_BP06_04" targetRef="Gw_BP06_Verified"/>
    <bpmn:sequenceFlow id="Flow_BP06_06" sourceRef="Gw_BP06_Verified" targetRef="Task_BP06_05" name="Approved"/>
    <bpmn:sequenceFlow id="Flow_BP06_07" sourceRef="Gw_BP06_Verified" targetRef="Task_BP06_06" name="Declined"/>
    <bpmn:sequenceFlow id="Flow_BP06_08" sourceRef="Task_BP06_05" targetRef="End_BP06"/>
    <bpmn:sequenceFlow id="Flow_BP06_09" sourceRef="Task_BP06_06" targetRef="End_BP06"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_HRH_BP_06">
    <bpmndi:BPMNPlane id="BPMNPlane_HRH_BP_06" bpmnElement="Collab_HRH_BP_06">
      <bpmndi:BPMNShape id="Pool_HRH_BP_06_di" bpmnElement="Pool_HRH_BP_06" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1650" height="600"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP06_GovernanceBody_di" bpmnElement="Lane_BP06_GovernanceBody" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP06_Custodian_di" bpmnElement="Lane_BP06_Custodian" isHorizontal="true">
        <dc:Bounds x="150" y="230" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP06_HealthWorker_di" bpmnElement="Lane_BP06_HealthWorker" isHorizontal="true">
        <dc:Bounds x="150" y="380" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP06_RegistrationOfficer_di" bpmnElement="Lane_BP06_RegistrationOfficer" isHorizontal="true">
        <dc:Bounds x="150" y="530" width="1620" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_BP06_di" bpmnElement="Start_BP06">
        <dc:Bounds x="202" y="137" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP06_01_di" bpmnElement="Task_BP06_01">
        <dc:Bounds x="340" y="121" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP06_02_di" bpmnElement="Task_BP06_02">
        <dc:Bounds x="525" y="271" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP06_03_di" bpmnElement="Task_BP06_03">
        <dc:Bounds x="710" y="421" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP06_04_di" bpmnElement="Task_BP06_04">
        <dc:Bounds x="895" y="271" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_BP06_Verified_di" bpmnElement="Gw_BP06_Verified" isMarkerVisible="true">
        <dc:Bounds x="1120" y="580" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP06_05_di" bpmnElement="Task_BP06_05">
        <dc:Bounds x="1265" y="545" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP06_06_di" bpmnElement="Task_BP06_06">
        <dc:Bounds x="1265" y="297" width="130" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_BP06_di" bpmnElement="End_BP06">
        <dc:Bounds x="1497" y="287" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_BP06_01_di" bpmnElement="Flow_BP06_01">
        <di:waypoint x="238" y="155"/>
        <di:waypoint x="340" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP06_02_di" bpmnElement="Flow_BP06_02">
        <di:waypoint x="470" y="155"/>
        <di:waypoint x="498" y="155"/>
        <di:waypoint x="498" y="305"/>
        <di:waypoint x="525" y="305"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP06_03_di" bpmnElement="Flow_BP06_03">
        <di:waypoint x="655" y="305"/>
        <di:waypoint x="683" y="305"/>
        <di:waypoint x="683" y="455"/>
        <di:waypoint x="710" y="455"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP06_04_di" bpmnElement="Flow_BP06_04">
        <di:waypoint x="840" y="455"/>
        <di:waypoint x="868" y="455"/>
        <di:waypoint x="868" y="305"/>
        <di:waypoint x="895" y="305"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP06_05_di" bpmnElement="Flow_BP06_05">
        <di:waypoint x="1025" y="305"/>
        <di:waypoint x="1073" y="305"/>
        <di:waypoint x="1073" y="605"/>
        <di:waypoint x="1120" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP06_06_di" bpmnElement="Flow_BP06_06">
        <di:waypoint x="1170" y="605"/>
        <di:waypoint x="1218" y="605"/>
        <di:waypoint x="1218" y="579"/>
        <di:waypoint x="1265" y="579"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP06_07_di" bpmnElement="Flow_BP06_07">
        <di:waypoint x="1170" y="605"/>
        <di:waypoint x="1218" y="605"/>
        <di:waypoint x="1218" y="331"/>
        <di:waypoint x="1265" y="331"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP06_08_di" bpmnElement="Flow_BP06_08">
        <di:waypoint x="1395" y="579"/>
        <di:waypoint x="1446" y="579"/>
        <di:waypoint x="1446" y="305"/>
        <di:waypoint x="1497" y="305"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP06_09_di" bpmnElement="Flow_BP06_09">
        <di:waypoint x="1395" y="331"/>
        <di:waypoint x="1446" y="331"/>
        <di:waypoint x="1446" y="305"/>
        <di:waypoint x="1497" y="305"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
