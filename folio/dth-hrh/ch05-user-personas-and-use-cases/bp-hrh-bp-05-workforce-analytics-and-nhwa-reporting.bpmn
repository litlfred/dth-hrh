<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_HRH_BP_05"
                  targetNamespace="https://litlfred.github.io/dth-hrh/bpmn">

  <bpmn:resource id="pers:workforce-planner" name="Workforce planner"/>
  <bpmn:resource id="pers:system-nhwa-platform" name="NHWA platform"/>

  <bpmn:collaboration id="Collab_HRH_BP_05">
    <bpmn:participant id="Pool_HRH_BP_05" name="HRH-BP-05 Workforce counts and NHWA reporting" processRef="HRH_BP_05"/>
  </bpmn:collaboration>

  <bpmn:process id="HRH_BP_05" name="Workforce counts and NHWA reporting (HRH-BP-05)" isExecutable="false">
    <bpmn:documentation>Produces de-identified workforce stock, distribution, skill-mix, attrition and migration indicators from the registry and submits validated aggregate extracts to the National Health Workforce Accounts (NHWA) platform.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_HRH_BP_05">
      <bpmn:lane id="Lane_BP05_WorkforcePlanner" name="Workforce planner" partitionElementRef="pers:workforce-planner">
        <bpmn:flowNodeRef>Start_BP05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP05_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP05_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BP05_Quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP05_03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP05_NHWAPlatform" name="NHWA platform" partitionElementRef="pers:system-nhwa-platform">
        <bpmn:flowNodeRef>Task_BP05_04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BP05</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BP05" name="Planning or NHWA reporting cycle">
      <bpmn:outgoing>Flow_BP05_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_BP05_01" name="Select reporting period, occupation (ISCO-08) and geography filters">
      <bpmn:incoming>Flow_BP05_01</bpmn:incoming>
      <bpmn:outgoing>Flow_BP05_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP05_02" name="Generate de-identified stock, distribution, inflow and attrition counts">
      <bpmn:incoming>Flow_BP05_02</bpmn:incoming>
      <bpmn:outgoing>Flow_BP05_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_BP05_Quality" name="Coverage complete?">
      <bpmn:incoming>Flow_BP05_03</bpmn:incoming>
      <bpmn:outgoing>Flow_BP05_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_BP05_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BP05_03" name="Annotate coverage gaps (e.g. private sector) and data provenance">
      <bpmn:incoming>Flow_BP05_05</bpmn:incoming>
      <bpmn:outgoing>Flow_BP05_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BP05_04" name="Ingest and validate aggregate NHWA indicator extract">
      <bpmn:incoming>Flow_BP05_04</bpmn:incoming>
      <bpmn:incoming>Flow_BP05_06</bpmn:incoming>
      <bpmn:outgoing>Flow_BP05_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_BP05" name="Workforce indicators published">
      <bpmn:incoming>Flow_BP05_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_BP05_01" sourceRef="Start_BP05" targetRef="Task_BP05_01"/>
    <bpmn:sequenceFlow id="Flow_BP05_02" sourceRef="Task_BP05_01" targetRef="Task_BP05_02"/>
    <bpmn:sequenceFlow id="Flow_BP05_03" sourceRef="Task_BP05_02" targetRef="Gw_BP05_Quality"/>
    <bpmn:sequenceFlow id="Flow_BP05_04" sourceRef="Gw_BP05_Quality" targetRef="Task_BP05_04" name="Complete"/>
    <bpmn:sequenceFlow id="Flow_BP05_05" sourceRef="Gw_BP05_Quality" targetRef="Task_BP05_03" name="Partial coverage"/>
    <bpmn:sequenceFlow id="Flow_BP05_06" sourceRef="Task_BP05_03" targetRef="Task_BP05_04"/>
    <bpmn:sequenceFlow id="Flow_BP05_07" sourceRef="Task_BP05_04" targetRef="End_BP05"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_HRH_BP_05">
    <bpmndi:BPMNPlane id="BPMNPlane_HRH_BP_05" bpmnElement="Collab_HRH_BP_05">
      <bpmndi:BPMNShape id="Pool_HRH_BP_05_di" bpmnElement="Pool_HRH_BP_05" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1140" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP05_WorkforcePlanner_di" bpmnElement="Lane_BP05_WorkforcePlanner" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1110" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP05_NHWAPlatform_di" bpmnElement="Lane_BP05_NHWAPlatform" isHorizontal="true">
        <dc:Bounds x="150" y="310" width="1110" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_BP05_di" bpmnElement="Start_BP05">
        <dc:Bounds x="208" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="188" y="192" width="76" height="72" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP05_01_di" bpmnElement="Task_BP05_01">
        <dc:Bounds x="290" y="124.5" width="170" height="91" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP05_02_di" bpmnElement="Task_BP05_02">
        <dc:Bounds x="500" y="124.5" width="170" height="91" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_BP05_Quality_di" bpmnElement="Gw_BP05_Quality" isMarkerVisible="true">
        <dc:Bounds x="720" y="145" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="705" y="100" width="80" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP05_03_di" bpmnElement="Task_BP05_03">
        <dc:Bounds x="910" y="124.5" width="170" height="91" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP05_04_di" bpmnElement="Task_BP05_04">
        <dc:Bounds x="910" y="351" width="170" height="68" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_BP05_di" bpmnElement="End_BP05">
        <dc:Bounds x="1140" y="367" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1123" y="407" width="70" height="54" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_BP05_01_di" bpmnElement="Flow_BP05_01">
        <di:waypoint x="244" y="170" />
        <di:waypoint x="290" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP05_02_di" bpmnElement="Flow_BP05_02">
        <di:waypoint x="460" y="170" />
        <di:waypoint x="500" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP05_03_di" bpmnElement="Flow_BP05_03">
        <di:waypoint x="670" y="170" />
        <di:waypoint x="720" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP05_04_di" bpmnElement="Flow_BP05_04">
        <di:waypoint x="745" y="195" />
        <di:waypoint x="745" y="385" />
        <di:waypoint x="910" y="385" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="770" y="358" width="70" height="18" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP05_05_di" bpmnElement="Flow_BP05_05">
        <di:waypoint x="770" y="170" />
        <di:waypoint x="910" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="126" width="75" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP05_06_di" bpmnElement="Flow_BP05_06">
        <di:waypoint x="995" y="215.5" />
        <di:waypoint x="995" y="351" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP05_07_di" bpmnElement="Flow_BP05_07">
        <di:waypoint x="1080" y="385" />
        <di:waypoint x="1140" y="385" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
