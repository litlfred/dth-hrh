{
  "contentType": "document",
  "adapter": "document",
  "adapterModule": "./folio-assistant-core/adapters/document/index.ts",
  "dependencies": {
    "folioAssistant": [
      {
        "name": "folio-assistant-core",
        "path": "folio-assistant-core"
      },
      {
        "name": "smart-base",
        "path": "smart-base"
      }
    ]
  },
  "feedbackDir": ".folio-feedback",
  "skills": ".claude/skills/local",
  "viewer": {
    "dir": "cat-harness-tools/viewer",
    "port": 8080
  },
  "readme": {
    "linkStyle": "blob",
    "publishRef": "gh-pages"
  },
  "site": {
    "build": {
      "sourceSteps": [
        "site:document",
        "site:wg-comment",
        "site:library",
        "site:review-sheet",
        "site:glossary",
        "site:archimate"
      ],
      "siteSteps": [
        "site:node-kinds"
      ],
      "pre": [
        "check:dth-glossary",
        "check:review-anchors",
        "check:kg-blocks",
        "check:library-kg",
        "check:page-furniture"
      ],
      "keep": [
        "ns"
      ]
    }
  },
  "_site_comment": "`site.build.keep`: `ns`, the JSON-LD context at ns/context/v1.jsonld that the block KG nodes name (iriBase in dth-hrh.json); the root publish keeps it, as smart-ra's does."
}
