    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/accreditation--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Accreditation"
        }
      ],
      "skos:definition": [
        {
          "@value": "In a health workforce context, the evaluation of educational institutions and programmes of study against pre-defined standards required for the delivery of education. The outcome of the process is certification of the suitability of education programmes, and the capability of educational institutions to deliver initial and/or continuing education."
        }
      ],
      "skos:scopeNote": "Cited as: )Health practitioner regulation: design, reform and implementation guidance. Geneva: World Health Organization; 2024;",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 3",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/active-health-worker--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Active health worker"
        }
      ],
      "skos:definition": [
        {
          "@value": "One who provides services to patients and communities (practising health worker) or whose medical education is a prerequisite for the execution of the job (e.g. education, research, public administration) even if the health worker is not directly providing services (professionally active health worker). If data are not available for practising or professionally active health workers, data with the closest definition can be used, such as “health worker licensed to practice”. Categories of level are based on the definitions of OECD/Eurostat/WHO-Europe Joint questionnaire on nonmonetary health care statistics."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 4",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/activity-level--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Activity level"
        }
      ],
      "skos:definition": [
        {
          "@value": "• Practising: This includes all health and care personnel directly providing services to or for patients and communities.\n• Professionally active: This includes practising health and care personnel as well as other personnel who are directly not providing services to patients but for whom their medical or paramedical education is a prerequisite for the execution of the job (e.g. education, research, public administration).\n• Licensed to practice: This includes all health and care personnel who are registered and entitled to practice."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 5",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/attrition--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Attrition"
        }
      ],
      "skos:definition": [
        {
          "@value": "Defined broadly as exits from the workforce, which can be due to emigration, voluntary exits (for example, to other sectors of employment), illness, death or retirement"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 6",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/certification--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Certification"
        }
      ],
      "skos:definition": [
        {
          "@value": "The recognition that an individual has met certain qualification requirements."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 7",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/community-health-workers--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Community health workers"
        }
      ],
      "skos:definition": [
        {
          "@value": "Health workers who provide health education, referral and follow-up, case management, basic preventive health care and home visiting services to specific communities. They provide support and assistance to individuals and families in navigating the health and social services system."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 8",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/competence--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Competence"
        }
      ],
      "skos:definition": [
        {
          "@value": "The state of a person’s proficiency to perform the required work activities to the defined standard. This includes having the requisite competencies in each context. Competence is multidimensional, dynamic and changes with time, experience and setting"
        }
      ],
      "skos:scopeNote": "Cited as: Health practitioner regulation: design, reform and implementation guidance. Geneva: World Health Organization; 2024",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 9",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/competencies--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Competencies"
        }
      ],
      "skos:definition": [
        {
          "@value": "The abilities of a person to integrate knowledge, skills, and attitudes in their performance of tasks in a given context. Competencies are durable, trainable and, through the expression of behaviours, measurable."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 10",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/continuing-professional-development--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Continuing professional development (CPD)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Training that is beyond clinical update and includes wide-ranging competences like research and scientific writing; multidisciplinary context of patient care; professionalism and ethical practice; communication, leadership, management and behavioural skills; team building; information technology; auditing; and appropriate attitudinal change to ensure improved patient service, research outcomes, and attainment of the highest degree of satisfaction by stakeholders.The form of continuing professional development (CPD) may include: courses and lectures; training days; peer review; clinical audit; reading journals; attending conferences; e-learning activity. CPD may be included in national standards of conduct, performance and ethics that govern health workers."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023. Expands an earlier definition in: WHO guideline on health workforce development, attraction, recruitment and retention in rural and remote areas. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 11",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/continuing-professional-development--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Continuing professional development (CPD)"
        }
      ],
      "skos:definition": [
        {
          "@value": "All educational experiences, activities and resources engaged by a health professional after completion of professional training. The form of continuing professional development may include courses and lectures, training days, peer review, clinical audit, reading journals, attending conferences, or e-learning activity. National systems for continuing professional development may be voluntary or mandatory."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 11",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/contract-type--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Contract type"
        }
      ],
      "skos:definition": [
        {
          "@value": "The contract type is a key employment characteristic of all workers, including health workers. Personnel may be categorized as full-time workers or part-time workers, depending on their specific contract types. Part-time workers refers to those employed persons whose normal hours of work (calculated weekly or on average over a given period of employment) are less than those of comparable full-time workers."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 12",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/deployment--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Deployment"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of allocating personnel among types and levels of services and among regions and subregions of a country."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 13",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/distribution--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Distribution"
        }
      ],
      "skos:definition": [
        {
          "@value": "The result of deployment. For example, balanced distribution refers to the appropriate allocation of health personnel, geographically and among levels of care and types of services, to ensure equitable provision of quality health services to all."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 14",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/dual-practice--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Dual practice"
        }
      ],
      "skos:definition": [
        {
          "@value": "Phenomenon in which a health practitioner is simultaneously employed or holds dual or multiple appointments (in both the public and private sectors) in regulated as well as unregulated ways and in an authorized or informal manner."
        }
      ],
      "skos:scopeNote": "Cited as: Health practitioner regulation: design, reform and implementation guidance. Geneva: World Health Organization; 2024",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 15",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/dual-practice--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Dual practice"
        }
      ],
      "skos:definition": [
        {
          "@value": "Multiple health-related practices by a health worker in the same or different sites. Dual practice in this sense may be public-on-public, public-on-private, or private-on-private."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 15",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/dual-practice--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Dual practice"
        }
      ],
      "skos:definition": [
        {
          "@value": "There are several forms of dual practice. Health professionals can work in a public service provision role and another role: (a) outside: in a completely separate private environment; (b) beside: in a private ward or clinic physically associated with a public facility but run as a separate business; (c) within: where private services are offered inside a public facility but outside public service operating hours or space; or (d) integrated: where additional fees are charged for services offered alongside standard public ones, often informally, on the understanding of a faster – or higher-quality – service. Academics and policy-makers typically restrict the term dual practice to category (a), but it is clear that categories (b), (c) and (d) present alternative scenarios for health professionals to combine public and private practice, and supplement public sector salaries; policy-making in this domain should navigate the trade-offs between the objective of retaining personnel while ensuring their commitment to public sector objectives (15)"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 15",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/education--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Education (for health workers)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of developing knowledge, skills, attitudes and competencies related to the delivery of health services. Specialization is the process of developing advanced knowledge, skills, attitudes and competencies related to the delivery of specific health services."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 16",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/educational-institution--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Educational institution"
        }
      ],
      "skos:definition": [
        {
          "@value": "An established institution that provides education as its main purpose, such as a school, college, university or training centre. Such institutions are normally accredited or sanctioned by the relevant national education authorities or equivalent to award qualifications. Educational institutions may also be operated by private organizations, such as religious bodies, special interest groups or private educational and training enterprises, both for-profit and non-profit."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 17",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/education-and-training-institution--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Education and training institution (Health workforce)"
        }
      ],
      "skos:definition": [
        {
          "@value": "An established institution that provides education as its main purpose, such as a school, college, university or training centre. Such institutions are normally accredited or sanctioned by the relevant national education authorities or equivalent to award qualifications. Educational institutions may also be operated by private organizations, such as religious bodies, special interest groups or private educational and training enterprises, both for-profit and not-for-profit. Types of health workforce education and training institutions are:\n• Public: Public educational institutions provide core educational services such as teaching activities and ancillary services. They include schools, colleges, universities, and training centres. They are controlled and managed directly by a public education authority or governing body (council, committee, etc.), the majority of whose members are appointed by a public authority.\n• Private: Private educational institutions provide core educational products such as teaching activities and ancillary services. They include schools, colleges, universities, and training centres, that are controlled and directly managed either by a private organization such as a church, trade union, or business enterprise, or by a governing board whose members have mostly not been selected by a public authority. Whether or not an institution is private is therefore a matter of management, not funding. A school, for example, could in theory be entirely publicly funded but still be considered private because it is not managed by the government. In practice, for international comparability, any educational institution not managed by a government institution is classified as private."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 18",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/employment-status-full-time-part-time-temporary-permanent--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Employment status: full-time, part-time, temporary, permanent"
        }
      ],
      "skos:definition": [
        {
          "@value": "Full-time (whole-time) is employment for or working for the amount of time considered customary or standard. Part-time is employment for or working for less than the amount of time considered customary or standard. Permanent is employment contracted for an indeterminate period. Fixed term is employment contracted for a fixed period of time. Temporary refers to short-term contracts or “casual” work, either for a definite period or for a specific activity. Self-employment is when remuneration is directly dependent upon the profits derived from the goods and services produced by the individual."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 19",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-labour-market--who-afro-hwf-charter",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health labour market"
        }
      ],
      "skos:definition": [
        {
          "@value": "The structure that allows the services of health workers to be sought (demanded) and offered (supplied). The health labour market can be characterized according to geographical area (local, national or international); occupation (by occupation title or category, specialized or unspecialized); and sector (private or public, formal or informal). The dynamic between the number and the kind of jobs offered on the market and the number of health workers is central in determining the configuration of the health labour market"
        }
      ],
      "skos:scopeNote": "Cited as: Africa Health Workforce Investment Charter: enabling sustainable health workforce invest ments for universal health coverage and health security for the Africa we want. Brazzaville: WHO African Region, 2024.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 20",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-practitioner--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health practitioner"
        }
      ],
      "skos:definition": [
        {
          "@value": "For the purpose of this document, the term “health practitioner” encompasses all health professionals, health associate professionals, including community health workers, health care assistants, and personal care workers in health services (allopathy as well as traditional, complementary and integrative medicine) as defined in the International Standard Classification of Occupations (ISCO-08), and new or health practitioners that are yet to fall under an official classification but who are directly involved in patient diagnostics or care"
        }
      ],
      "skos:scopeNote": "Cited as: Health practitioner regulation: design, reform and implementation guidance. Geneva: World Health Organization; 2024",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 21",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-professional--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health professional"
        }
      ],
      "skos:definition": [
        {
          "@value": "Health personnel who apply knowledge, such as those relating to medicine, nursing, midwifery, dentistry, and allied health and health promotion; they usually require a university undergraduate or postgraduate degree or the equivalent"
        }
      ],
      "skos:scopeNote": "Cited as: Health practitioner regulation: design, reform and implementation guidance. Geneva: World Health Organization; 2024",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 22",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-professions-education-accreditation-agency--who-gdhcn-framework-2026",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Professions Education Accreditation Agency"
        }
      ],
      "skos:definition": [
        {
          "@value": "An organization or organizational unit that is responsible for establishing and/or implementing procedures for accreditation of health professions education institutions4."
        }
      ],
      "skos:scopeNote": "Cited as: Framework for the adminstration and operations of the WHO Global Digital Health Certification Network (GDHCN). 2026",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 23",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-services-licensing-agency--who-gdhcn-framework-2026",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Services Licensing Agency"
        }
      ],
      "skos:definition": [
        {
          "@value": "An organization or organizational unit that is responsible for establishing and/or implementing procedures for licensure, and the licensing of organizations or individuals to provide clinical, health system or public health services within their jurisdiction. Licensing comprises processes through which duly authorized governmental authorities, such as recognized professional organizations, grant permission to an individual or healthcare organization to operate or engage in a medical occupation or profession."
        }
      ],
      "skos:scopeNote": "Cited as: Framework for the adminstration and operations of the WHO Global Digital Health Certification Network (GDHCN). 2026",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 24",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workers--who-wpro-hwf-framework-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workers"
        }
      ],
      "skos:definition": [
        {
          "@value": "All persons engaged in actions whose primary intent is to enhance health (3,5)."
        }
      ],
      "skos:scopeNote": "Cited as: Regional framework to shape a health workforce for the future of the Western Pacific. Manila: World Health Organization Regional Office for the Western Pacific; 2024.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 25",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-planning--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce planning"
        }
      ],
      "skos:definition": [
        {
          "@value": "Strategies that address the adequacy of the supply and distribution of the health workforce according to policy objectives and the consequential demand for health labour. (63)"
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 26",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-planning--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce planning"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of estimating potential requirements for human resources for health and of designing ways of fulfilling those requirements, including strategies that address the adequacy of the supply and distribution of the health workforce according to policy objectives and the consequential demand for health labour (8)"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 26",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce--who-afro-hwf-charter",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce (HWF)"
        }
      ],
      "skos:definition": [
        {
          "@value": "All people engaged in actions whose primary intent is to enhance health. They may be paid staff or volunteers working full-time or part-time in the public and private sectors. They may be delivering health services, managing the services offered by the system, or addressing social determinants of health. That means that the health workforce includes: all personnel trained in health occupations delivering clinical work in health facilities (such as medical doctors, nurses, or dentists); all non health professionals employed in the health sector, public and private, regardless of their occupation (such as managers, ambulance drivers or teachers of health education); and all those whose work supports the delivery of health services, even if they are employed by other sectors or industries (such as cleaning, catering, security or agency staff working in the health sector)"
        }
      ],
      "skos:scopeNote": "Cited as: Africa Health Workforce Investment Charter: enabling sustainable health workforce invest ments for universal health coverage and health security for the Africa we want. Brazzaville: WHO African Region, 2024.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 27",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--who-itu-dpi-h-ra-draft-2026",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Health Workforce Registry is the national authoritative record of identity, credential, and classification data for all health workers recognised as part of the national health workforce — including licensed or certified professionals employed in both public and private sectors and, where nationally defined and registered, community health workers and other cadres operating in informal or semi-formal capacities. It maintains a standardised, uniquely identified record for each health worker, providing the common reference point against which clinical, administrative, financing, and regulatory systems can consistently identify, verify, and classify the people delivering health services."
        }
      ],
      "skos:scopeNote": "Cited as: DRAFT V1.0 Reference Architecture and Guidance for Digital Public Infrastructure for the Health Sector: A Digital Transformation Handbook for Digital Public Infrastructure for Health (DPI-H). July 2026",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 28",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--who-itu-dpi-h-ra-draft-2026-2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Health Workforce Registry is the national authoritative record of identity, credential, and classification data for all health workers recognised as part of the national health workforce — including licensed or certified professionals employed in both public and private sectors and, where nationally defined and registered, community health workers and other cadres operating in informal or semi-formal capacities. It maintains a standardised, uniquely identified record for each health worker, providing the common reference point against which clinical, administrative, financing, and regulatory systems can consistently identify, verify, and classify the people delivering health services.\n\nThe registry holds two interlocking categories of information: 1. The first is identity: who the health worker is — their demographics, unique identifier, and may cross-reference to foundational identification systems. 2. The second is credentials: what the health worker is qualified and authorised to do — their 240 occupational classification, professional registration, licensing status, and qualifications.\n\nTogether, these form the data foundation for a health system that can assure the quality and accountability of its workforce at scale.\n\nThe WHO National Health Workforce Accounts (NHWA) handbook (Second Edition, 2023) defines 29 244 indicators that underpin health workforce monitoring, planning, and policy — covering stock, flow, education, migration, and expenditure. The national health workforce registry is a key data source for 12 of 246 these indicators, notably those measuring stock and flow – critical to workforce planning and equitable distribution. The Health Workforce Registry, as defined in the DPI-H reference architecture, provides the foundational data infrastructure from which these indicators can be derived.\n\nArchitecture placement: The Health Workforce Registry is a core DPI-H foundational component — the shared identity and credential anchor for health workers across the health ecosystem. It is architecturally distinct from two operational systems: the Human Resources Information System (HRIS), which manages employment transactions, payroll processing, leave management, and workforce scheduling; and the Learning Management System (LMS), which manages training delivery, course enrolment, and assessment. The Health Workforce Registry holds the authoritative master record of who a health worker is and what they are qualified and licensed to do. The HRIS and LMS consume this registry as their reference source; neither replaces it."
        }
      ],
      "skos:scopeNote": "Cited as: DRAFT V1.0 Reference Architecture and Guidance for Digital Public Infrastructure for the Health Sector: A Digital Transformation Handbook for Digital Public Infrastructure for Health (DPI-H). July 2026",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 3",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--who-hrhis-mds-2015",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"In a national context an electronic health workforce registry can be considered the single authoritative source of health workforce information that can provide an accurate count of all health care personnel that either have worked or are currently working at national or sub-national levels, including in the private sector. An electronic health workforce registry can be designed to authenticate and validate the existence of a health worker and provide essential details about that person.\" (p. 7) The health workforce registry is a central and essential component of a functional HRIS, as it contains important health worker attributes that can subsequently be linked to other relevant HRIS components.\" (p8)\n\n\"In this document, a minimum data set is proposed to construct an electronic health workforce registry. Using this tool, data elements can be standardized within electronic systems to help facilitate the collection, collation, analysis, reporting and utilization of national and sub-national health workforce data. The tool can also assist in achieving data interoperability between and within information systems.\"(p8)"
        }
      ],
      "skos:scopeNote": "Cited as: Human Resources for Health Information System: Minimum Data Set for Health Workforce Registry. Geneva: World Health Organization; 2015.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 4",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "“Regulators generally maintain a registry of regulated practitioners to keep the public informed of those authorized as competent to practice and those who have been suspended or removed from the registry. The level of detail available about practitioners through the regulator’s public website varies between regulators, occupations and countries, from a simple verification of registration to details on qualification, and practice and disciplinary history. Different types of registration exist (for example, student, temporary, provisional, limited practice, supervised practice, private practice, public sector practice, independent practice, specialized practice and nonclinical practice). These determine where a health practitioner can work, their scope of work and level of independence. While in some countries periodic renewals are required to maintain a practitioner’s registration or licence, in others, regulators have limited capacity to maintain a complete registry (p11)\n\nBased on data available from regulators, the registries of regulated health practitioners may include information on the number of students in health occupations, active and inactive health practitioners, their personal details, place of education and employment, and the jurisdiction of registration within a country. (p13)\n\nThe inclusion of disciplinary history in public registries can help patients, clients and employers to make informed choices about practitioners. Regulators can use the data to identify and reduce the risk of harm to the public through preventative action or early identification and intervention (p45)\n\nA core function of regulators is to maintain a publicly available registry on regulated health practitioners that is accurate, complete and includes information on practitioners who have been removed from the registry. This enables access to information on practitioners by both the public seeking services and employers recruiting the practitioners. Depending on the occupation and jurisdiction, the information in the public registry can vary. The health practitioner registry accessible to the public is in compliance with legislation and requirements on confidentiality and the handling of personal data and generally includes relevant information on the practitioners such as name, gender, age, registration number, qualification details (such as basic and additional qualifications, conferring institution, year conferred), scope of registration or licensure, disciplinary history and associated sanctions and actions (26, 115, 286–288). Since maintaining an up-to-date public registry has resource implications, the costs and benefits should be assessed for each data point included in the register. Information shared in the public registry is only a subset of the information that is collected by the regulators. Additional information captured by regulators could include practitioner characteristics such as language skills, country of birth, nationality, details on practice location, criminal history records, fitness to practice, and complaints and disciplinary actions. Information on employers may also be captured (26, 289–292). Some of the information held by regulators is confidential and the grounds on which this information may be shared and with whom need to be specified by law. Similarly, the regulator for health practitioner education could hold information on the capacity of the institutions as well as annual data on enrolments and graduates (if applicable) in different programmes, including gender, age, country of birth and the nationality of students. Where assessments of practitioner performance standards are regular and linked to periodic registration or licensure renewals, it can help to keep the practitioner registry updated. In such cases, the available data (for example, on education, entry to practice, maintenance of standards, complaints and discipline) should be analysed to detect clinical governance failures that harm patients, identify innovations and generate evidence and data for improving regulatory systems, practice environments, service delivery and patient safety (p46)"
        }
      ],
      "skos:scopeNote": "Cited as: World Health Organization. Health Practitioner Regulation: Design, Reform and Implementation Guidance. Geneva: WHO; 2024.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 5",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--who-hwf-data-handbook-2022",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "“Professional registries maintained by regulators: Regulators maintain a registry of health workers who have been authorized to enter into practice. The information on the registry varies between countries and regulators. In some countries the registration or licensure of health workers is time-limited and requires periodic renewals while in others it can be valid for life.”"
        }
      ],
      "skos:scopeNote": "Cited as: Strengthening the collection, analysis and use of health workforce data and information: a handbook (WHO, 2022)",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 6",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--joachim-hwf-forecasting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "“Interoperable health professional registers with a clear legal basis underpin workforce intelligence. Effective registers that integrate data from education, licensing and employment systems are essential if countries are to forecast better at the national and regional levels.” (p5)\n\n\"A health professional register is an official, usually mandatory, system that records information on individuals who are authorized to practise a regulated health profession. Registers are typically maintained by professional regulators or public authorities and contain data such as professional qualifications, scope of practice, licensing status and, depending on the system, information on employment, sector, working hours and location.\" (p. 23)\n\n\"Their primary purpose is to support professional regulation and patient safety, but they can also serve as a critical source of workforce intelligence. Health professional registers represent a critical source of high-quality, routinely updated workforce intelligence. They provide a robust empirical foundation for understanding the size, composition, distribution, and activity patterns of the HCWF and can inform a wide range of policy functions, including workforce forecasting and planning, education and training capacity, regulation, distribution and budgeting.\" p23."
        }
      ],
      "skos:scopeNote": "Cited as: Joachim M, Kovács E, Cserháti Z, Williams GA, Falkenbach M, Wismar M. Aligning health workforce forecasting and planning with changing care models: the role of integrated data, mixed methods and professional registers. Policy Brief 78 (HEROES Brief 2). Copenhagen: European Observatory on Health Systems and Policies, WHO Regional Office for Europe; 2026",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 7",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--intrahealth-hwis-2013",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"...a Provider Registry (PR), also called a Healthcare Provider Directory (HPD), which “supports queries against, and management of, healthcare provider information that may be publicly shared in a directory structure.” The scope of the data is national and cross-sectoral but limited to rudimentary provider information. The PR, as part of a Service Oriented Architecture (SOA), is intended to be the canonical source of health worker data for a country. Within the HWIS, it has the potential to serve as the interface mechanism for the various components highlighted in Section 2.\""
        }
      ],
      "skos:scopeNote": "Cited as: Leitner C, Newman C, Settle D. \"Implementation and Use of Health Worker Information Systems in Low Resource Settings\" (IntraHealth International, 2013).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 8",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--openhie-hwr-ig-2016",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "Glossary: \"Health Worker Registry: a national authority of health worker information according to a defined minimum data set.\" \"Provider Registry: Another synonym for Health Worker Registry.\" \"Health Worker Directory: List of health workers that are managed by individual organizations, which can come together to form a health worker registry.\"\n\nNarrative definition: \"A Health Worker Registry (HWR) serves as the digital, central authority for maintaining the unique virtual identities of health workers within a country. . The Health Worker Registry pulls data from underlying human resource information systems (HRIS), which play the role of Health Worker Directories, and makes these data available as a single virtual database. These Health Worker Directories could include Ministry of Health installations of tools like iHRIS, private systems used by faith-based organizations, and private-sector systems as well as those used by regulatory bodies like nursing councils. These health Worker directories are responsible for specific business processes: maybe one tracks health worker certifications for a professional council or another holds salary information for the ministry of health. The information stored in these directories mirrors their business cases. The Health Worker Registry has no business case other than being a master document of all health worker information that specific directories can pull and share. The Health Worker Registry contains a Minimum Data Set (MDS) of details of all health workers working in both public and private sectors, such as full name, contact information and place(s) of employment.\n\nThe Health Worker Registry (HWR) serves as the authority for maintaining the unique identities of health workers within a country (p12)\n\nGovernments collect and store multiple and disparate sources of data on health workers. Thus, it is a complex task to pull together and maintain a master list of all health workers in a country. A Health Worker Registry (HWR) seeks to reduce the complexity of this task by: ● creating a Minimum Data Set (MDS) of health workforce information from the various source data systems ● merging the information from a variety of data systems into an authoritative registry of health workers according to a data governance policy ● allowing queries of health worker information by various computer and human users, also called the client systems.\n\nThe HWR serves as a publicly available “electronic phone-book” of health workers and health services across all sectors (public, private and faith-based organizations). As the World Health Organization points out, the HWR can be seen as the “single authoritative source” of health workforce information that parts of the HIS can query to obtain details on health workers and automatically populate their databases, rather than having to manually enter those details themselves."
        }
      ],
      "skos:scopeNote": "Cited as: \"OpenHIE Health Worker Registry (HWR) Implementation Guide\" (IntraHealth International/CapacityPlus, 2016 revision).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 9",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--intrahealth-2015",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"searchable directory of minimal set of health worker information\" \"no intrinsic management function\" \"designed to fit in as part of larger health information system.\" Health Worker Registry Combines Data Sources: pulling together Deployment, License, and Training data from separate source systems."
        }
      ],
      "skos:scopeNote": "Cited as: \"Health Worker Registries, Minimum Data Sets & National Health Workforce Accounts\" (IntraHealth Tech Tuesday presentation, 30 June 2015).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 10",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--chibuzor-hwfis-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"HWR or HRH registry is a 'single authoritative source of health workforce information, that can provide an accurate count of all health care personnel that either has worked or are currently working at national or sub-national levels, including in the private sector'\" (World Health Organization. Monitoring the building blocks of health systems: a handbook of indicators and their measurement strategies.)\n\n\"The HWR does not function in isolation. It is a part of the Human Resource Information System (HRIS) (also called health workforce information system). HRIS is a system that collects, maintains and analyses data on the health workforce. Other components of HRIS are payroll, training, performance management,migration, benefits and retirement components (Fig. 1). The HWR is, however, a central component of the HRIS and provides data on which all the other components depend."
        }
      ],
      "skos:scopeNote": "Cited as: Chibuzor M, Arikpo I, Aquaisua E, Esu E, Okoroafor SC, Omar S, Effa E, Oyo-Ita A, Meremikwu M. \"Implementation of health workforce information systems: a review of eight sub-Saharan country experiences.\" Journal of Public Health. 2021;43(Suppl 1):i27-i40. doi:10.1093/pubmed/fdaa263.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 11",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--dhe-planning-deck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"A health worker registry is the central authority for maintaining the unique identities of health providers within the country\""
        }
      ],
      "skos:scopeNote": "Cited as: \"Digital Health Enterprise Planning Approach\" — digital health architecture training/course slide deck referencing the OpenHIE architecture and the WHO/ITU National eHealth Strategy Toolkit (undated).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 12",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-registry--who-mds-crosswalk",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce registry"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"A health worker registry is a centralized listing of health workers within a country. Information contained within a health worker registry most often comes from different health management information systems (HMIS), such as iHRIS, used, for example, by independent organizations, health clinics run by non-state actors or regulatory bodies. These client systems are often organized around specific workflows revolving around human resources (hiring a new health worker, providing a salary bonus, transferring a health worker to a new location), but the health worker registry may contain only specific information about health workers.\""
        }
      ],
      "skos:scopeNote": "Cited as: \"WHO Minimum Data Set (MDS) Crosswalk\" — guidance document/tool for mapping the WHO Minimum Data Set to local data elements and vice versa, for use in implementing a health worker registry (undated).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HWF registry!row 13",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-observatory--who-afro-workforce2030-2020",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce observatory"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Health Workforce Observatory is a platform or mechanism for generating, analyzing, sharing, and using human resources for health (HRH) data and evidence to support policy-making, planning, monitoring, and research. The African Regional Framework describes national health workforce observatories as platforms for generating and sharing HRH data and best practices and notes that workforce observatories support evidence-based policies"
        }
      ],
      "skos:scopeNote": "Cited as: The African Regional Framework for the Implementation of the Global Strategy on Human Resources for Health: Workforce 2030. (WHO, 2020)",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 29",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-observatory--who-hwf-data-handbook-2022",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce observatory"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where they exist, HRH observatories are an excellent governance platform for the coordination of NHWA implementation. These observatories can be expanded and adapted to align progressively with NHWA implementation principles and requirements.” Page: 259 “In the WHO African, Americas and South-East Asia regions, several countries mutualize forces through HRH observatories to collect, analyse and disseminate health workforce data. These initiatives resulted from understanding that no single organization or body can compile all the relevant health workforce indicators without overburdening countries and duplicating efforts already conducted by others.” Page: 263"
        }
      ],
      "skos:scopeNote": "Cited as: Strengthening the collection, analysis and use of health workforce data and information: a handbook (WHO, 2022),",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 29",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-observatory--who-hrh-observatories-2012",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce observatory"
        }
      ],
      "skos:definition": [
        {
          "@value": "There is no consensual definition of what an observatory is. There are various ways and means to achieve the same goals and objectives, and no blue-print or “best practice” can be prescribed (Hemmings, Wilkinson 2003). In the social sector, these organizations go beyond observing and analysing; they also pro-actively intervene on the reality, which they monitor. The simple activity of data and information-gathering and dissemination has effects on the reality of the sector and on the actors’ behaviours. HRH observatories are no exception, and in this sense they are rather more like independent policy think-tanks. It is therefore important to note first that there are various “types” of HRH observatory, which take different forms depending on when they were established, by whom, where they are located organizationally, what functions and activities they perform, which resources and funding sources they have, and on the actors involved in their development and management. Table 1 presents that variety of types of observatories according to a number of significant dimensions."
        }
      ],
      "skos:scopeNote": "Cited as: Human Resources for Health Observatories: Contributing to Evidence-Based Policy Decisions (WHO, 2012)",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 29",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/health-workforce-observatory--openhie-hwr-ig-2016",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Health workforce observatory"
        }
      ],
      "skos:definition": [
        {
          "@value": "A cooperative organization designed to promote, develop and sustain a knowledge base for human resources for health in a region or country. It provides evidence for policy decisions to strengthen health systems and improve health service delivery.\""
        }
      ],
      "skos:scopeNote": "Cited as: \"OpenHIE Health Worker Registry (HWR) Implementation Guide\" (IntraHealth International/CapacityPlus, 2016 revision).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 29",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-management--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources management"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of creating an adequate organizational environment and management of health workers, including hiring, defining incentive systems, performance monitoring, supervision, and career development"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 30",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "An information system that provides, analyses, evaluates and distributes information needed to support decision-making and health personnel management and practices."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 31",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--who-hlma-2021-2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "HRH-IS: An information system that provides, analyses, evaluates and distributes information needed to support decision-making and health personnel management and practices. P280"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 3",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--who-hwf-data-handbook-2022",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human resources for health information system (HRHIS) is the basic tool that can provide data and information on the health workforce situation and its evolution.” p267; An HRHIS enables the monitoring of key information on HRH, such as stock and demography, education, finances, regulations, etc. It is an integrated element of the broader HIS, not an isolated subsystem.\"Page: 310"
        }
      ],
      "skos:scopeNote": "Cited as: Strengthening the collection, analysis and use of health workforce data and information: a handbook (WHO, 2022),",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 4",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--eurohealth-2022",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "“An HRHIS is a subsystem of an HIS, composed of various subsystems such as the payroll information system, education management information system (EMIS), and councils’ and professional associations’ records and information systems.” p261"
        }
      ],
      "skos:scopeNote": "Cited as: The European Health Workforce: Building a True Labour Market for Health Workers” (Eurohealth, 2022).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 5",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--riley-hrhis-review-2012",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"Increasingly, systems for collecting and disseminating information on a country’s health workforce – referred to as human resources information systems (HRIS)... Functional HRIS models involve standardized processes for data capture, management, and use so as to provide accurate, timely, and comprehensive profiles of workforce size, composition, and deployment\""
        }
      ],
      "skos:scopeNote": "Cited as: Riley PL, Zuber A, Vindigni SM, Gupta N, Verani AR, et al. \"Information systems on human resources for health: a global review.\" Human Resources for Health. 2012;10:7.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 6",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--intrahealth-hwis-2013",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"A Human Resource Information System (HRIS)... is one [of] the key components of the HWIS that manages information on current and past employees of a Ministry of Health or other health service delivery organization. An HRIS is concerned with the information related to position/post, job, cadre and other information related to employee management and deployment\""
        }
      ],
      "skos:scopeNote": "Cited as: Leitner C, Newman C, Settle D. \"Implementation and Use of Health Worker Information Systems in Low Resource Settings\" (IntraHealth International, 2013).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 7",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--ishijima-hrhis-tanzania",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "Describes Tanzania’s \"Human Resource for Health Information System (HRHIS)\": \"HRHIS is a web-based software that enables a health system to collect, validate, analyse and present raw and statistical human resource information for reporting, analysis and decision-making\""
        }
      ],
      "skos:scopeNote": "Cited as: Ishijima H, Mapunda M, Mndeme M, Sukums F, Mlay VS. \"Challenges and opportunities for effective adoption of HRH information systems in developing countries: national rollout of HRHIS and TIIS in Tanzania.\" Human Resources for Health. 2015;13:48.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 8",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--were-south-south-hris",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "HRIS collects and manages routine, national level, multi-cadre data on the health workforce including supply (i.e., training, exam, registration, licensure, intent to out-migrate, and continuing professional development) and deployment (i.e., health facility of deployment, date of appointment, workstation in the facility, date of promotion, disciplinary actions, date of exit, and transfers).\""
        }
      ],
      "skos:scopeNote": "Cited as: Were V, Jere E, Lanyo K, Mburu G, Kiriinya R, Waudo A, Chiteba B, Waters K, Mehta P, Oluoch T, Rodgers M. \"Success of a South-South collaboration on Human Resources Information Systems (HRIS) in health: a case of Kenya and Zambia HRIS collaboration.\" Human Resources for Health. 2019;17:6.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 9",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--chibuzor-hwfis-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"HRIS is a system that collects, maintains and analyses data on the health workforce. Other components of HRIS are payroll, training, performance management, migration, benefits and retirement components\" (p.i28, Fig.1). Data collected covers \"the health worker from pre-entry into the workforce to exit at retirement\" including \"identification number, name, birth history, employment status, address, education, professional licensure and certification\" (p.i28)."
        }
      ],
      "skos:scopeNote": "Cited as: Chibuzor M, Arikpo I, Aquaisua E, Esu E, Okoroafor SC, Omar S, Effa E, Oyo-Ita A, Meremikwu M. \"Implementation of health workforce information systems: a review of eight sub-Saharan country experiences.\" Journal of Public Health. 2021;43(Suppl 1):i27-i40. doi:10.1093/pubmed/fdaa263.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 10",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--measure-evaluation-m3-2018",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"A human resources information system (HRIS) provides data to track the status of the workforce in terms of the number, occupation, and geographical distribution of health workers.\""
        }
      ],
      "skos:scopeNote": "Cited as: MEASURE Evaluation's Module 3, 2018",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 11",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--waters-zhris",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"A human resources information system (HRIS) is a system of collection, storage, analysis, and reporting of data to produce meaningful information about the health workforce, including demographics, capacity, training needs, deployment, and migration patterns.\""
        }
      ],
      "skos:scopeNote": "Cited as: Zimbabwe’s Human Resources for health Information System (ZHRIS)—an assessment in the context of establishing a global standard Keith P. Watersa,*, Alexandra Zubera, Tungamirirai Simbinib, Zwashe Banganic, Ramesh S. Krishnamurthyd. Int J Med Inform. 2017 April ; 100: 121–128.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 12",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/human-resources-for-health-information-system--wikipedia-hrhis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Human resources for health information system"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human resource for health information system (HRHIS), also known as human resource information system (HRIS) — is a system for collecting, processing, managing and disseminating data and information on human resource for health (HRH). Depending on the level of development of a country's health care system and the organization of its workforce, an HRHIS can be computerized or paper-based, including information on numbers and distribution of health workers and track their career information.[1]"
        }
      ],
      "skos:scopeNote": "Cited as: Wikipedia. https://en.wikipedia.org/wiki/HRHIS",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#HRHIS!row 13",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/in-service-training--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "In-service training"
        }
      ],
      "skos:definition": [
        {
          "@value": "Training received while one is fully employed in the health sector. The aim is to equip health workers or the trainers of health workers with the skills to deliver specific interventions. (69"
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 32",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/in-service-training--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "In-service training"
        }
      ],
      "skos:definition": [
        {
          "@value": "Maintenance and adaptation of the competencies of existing personnel within the context of their current position; training received while one is employed in the health sector (8)"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 32",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/international-standard-classification-of-occupations--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "International Standard Classification of Occupations (ISCO)"
        }
      ],
      "skos:definition": [
        {
          "@value": "An international classification for organizing jobs into a clearly defined set of groups according to the tasks and duties undertaken in the job. It is maintained by the International Labour Organization."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 33",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/labour-force-survey--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Labour force survey"
        }
      ],
      "skos:definition": [
        {
          "@value": "A household-based sample survey focused on the labour force status of the working age population and related statistics. Such surveys often allow disaggregation of the labour force by personal characteristics such as sex, age, educational attainment, and, in some cases, by migrant status and ethnicity, as well as providing information about the jobs held by employed persons (such as occupation and type of contract)."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 34",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/licensing--who-wpro-hwf-framework-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Licensing"
        }
      ],
      "skos:definition": [
        {
          "@value": "A process by which a governmental authority grants permission to an individual practitioner or health-care organization to operate or to engage in an occupation or profession (4)."
        }
      ],
      "skos:scopeNote": "Cited as: Regional framework to shape a health workforce for the future of the Western Pacific. Manila: World Health Organization Regional Office for the Western Pacific; 2024.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 35",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/licensing--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Licensing"
        }
      ],
      "skos:definition": [
        {
          "@value": "Licensure is a process by which a governmental authority grants permission to an individual practitioner or health care organization to operate or to engage in an occupation or profession. Licensure regulations are generally established to ensure that an organization or individual meets minimum standards to protect public health and safety. Licensure to individuals is usually granted after some form of examination or proof of education and may be renewed periodically through payment of a fee and/or proof of continuing education or professional competence (11)."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 35",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/migration--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Migration"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process of movement of people from one country, region or place to settle in another. Moving out is emigration; moving in is immigration. The expressions of outflow and inflow are also used"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 36",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/mobility-flow--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Mobility flow"
        }
      ],
      "skos:definition": [
        {
          "@value": "The movement of personnel between positions, organizations and regions, or from the public to the private sector within a country, or out of the health sector"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 37",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/national-health-workforce-accounts--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "National Health Workforce Accounts (NHWA)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The NHWA can be defined as – “a system by which countries progressively improve the availability, quality, and use of data on health workforce through monitoring of a set of indicators to support achievement of Universal Health Coverage, Sustainable Development Goals and other health objectives”."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 38",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/occupation--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Occupation"
        }
      ],
      "skos:definition": [
        {
          "@value": "A set of jobs with main tasks and duties that are characterized by a high degree of similarity"
        }
      ],
      "skos:scopeNote": "Cited as: Health practitioner regulation: design, reform and implementation guidance. Geneva: World Health Organization; 2024",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 39",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/occupation--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Occupation"
        }
      ],
      "skos:definition": [
        {
          "@value": "The concept of occupation is defined as a “set of jobs whose main tasks and duties are characterized by a high degree of similarity”. A job is defined as “a set of tasks and duties performed, or meant to be performed, by one person, including for an employer or in self-employment”. The National Health Workforce Accounts covers health and health-related occupations grouped according to the International Standard Classification of Occupations 2008."
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 39",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/place-of-training--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Place of training"
        }
      ],
      "skos:definition": [
        {
          "@value": "This is defined as the place of first qualification for the health worker. Personnel may be categorized as either domestic-trained, foreign-trained, or their place of training may be unknown. The foreign trained health personnel may also be disaggregated into “foreign-trained national-born” (people born in a country who went to study in another country but have come back afterwards to practice in their home country) and “foreign-trained foreign-born”. (101)"
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 40",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/pre-service-education--who-nhwa-2023",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Pre-service education"
        }
      ],
      "skos:definition": [
        {
          "@value": "All mandatory educational activities occurring before graduates enter into service, i.e. excluding all education and training activities done in-service and continuing professional development"
        }
      ],
      "skos:scopeNote": "Cited as: National health workforce accounts: a handbook, second edition. Geneva: World Health Organization; 2023.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 41",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/professional-council--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Professional council"
        }
      ],
      "skos:definition": [
        {
          "@value": "Organization with the legal authority to regulate one or more health occupations with a view to protecting the public. Its mandate can cover the regulation of entry into the occupation (education requirements), the monitoring and promotion of the quality of practice, and administration of discipline... At national level (and at subnational level where legislative power exists), examples of mandatory rules are professional laws that define the powers and duties of professional councils, such as registration, certification of specialties and discipline. They also define scopes of practice that, in turn, shape the division of labour in the HLM."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 42",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/professional-council--openhie-hwr-ig-2016",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Professional council"
        }
      ],
      "skos:definition": [
        {
          "@value": "A national, legislatively mandated entity that certifies one or more cadres of health workers as meeting predetermined professional requirements and standards of practice."
        }
      ],
      "skos:scopeNote": "Cited as: \"OpenHIE Health Worker Registry (HWR) Implementation Guide\" (IntraHealth International/CapacityPlus, 2016 revision).",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 42",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/qualification--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Qualification"
        }
      ],
      "skos:definition": [
        {
          "@value": "Official confirmation, usually in the form of a document certifying the successful completion of an educational programme or a stage of a programme. Qualifications can be obtained through: (1) successful completion of a full programme; (2) successful completion of a stage of a programme (intermediate qualifications); or (3) validation of acquired knowledge, skills and competencies that is independent of participation in such programmes."
        }
      ],
      "skos:scopeNote": "Cited as: Health practitioner regulation: design, reform and implementation guidance. Geneva: World Health Organization; 2024",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 43",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/recruitment--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Recruitment"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process of searching for personnel to enter a particular job or position."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 44",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/registration--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Registration"
        }
      ],
      "skos:definition": [
        {
          "@value": "Official recording of the names of persons who have certain qualifications to practise a profession or occupation"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 45",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/registration--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Registration"
        }
      ],
      "skos:definition": [
        {
          "@value": "“Registration and licensure are used synonymously in many countries, but in others they mean different things.” “Under a statutory registration scheme, the provider’s name is placed on a list of people who are considered qualified to provide a service and they are then entitled to use a reserved professional title."
        }
      ],
      "skos:scopeNote": "Cited as: World Health Organization. Health Practitioner Regulation: Design, Reform and Implementation Guidance. Geneva: WHO; 2024.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 45",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/regulation--who-hpr-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Regulation"
        }
      ],
      "skos:definition": [
        {
          "@value": "All laws or rules that govern an individual’s entry to health practitioner education programmes, entry to practice, registration, licensure, scope of practice, maintenance of practice standards, disciplinary actions for deviation from regulatory standards, and associated linkages with the health system – adapted from (9)."
        }
      ],
      "skos:scopeNote": "Cited as: Health practitioner regulation: design, reform and implementation guidance. Geneva: World Health Organization; 2024",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 46",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/regulation--who-rural-retention-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Regulation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Can be defined broadly to encompass any government control exercised through legislative, administrative, legal or policy tools"
        }
      ],
      "skos:scopeNote": "Cited as: WHO guideline on health workforce development, attraction, recruitment and retention in rural and remote areas. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 46",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/regulation--who-wpro-hwf-framework-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Regulation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Any government control exercised through legislative, administrative, legal or policy tools (3)."
        }
      ],
      "skos:scopeNote": "Cited as: Regional framework to shape a health workforce for the future of the Western Pacific. Manila: World Health Organization Regional Office for the Western Pacific; 2024.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 46",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/regulation--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Regulation"
        }
      ],
      "skos:definition": [
        {
          "@value": "The definition of rules that will govern the structure and functioning of education institutions and of service provider organizations and the professional activities of individual health workers."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 46",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/retention--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Retention (of health workers)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Maintenance of health personnel in a specific position or organization, the health sector, region, or country"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 47",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/scope-of-practice--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope of practice"
        }
      ],
      "skos:definition": [
        {
          "@value": "The set of tasks that members of a specific occupation are authorized to perform"
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 48",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/scope-of-practice--who-rural-retention-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope of practice"
        }
      ],
      "skos:definition": [
        {
          "@value": "the health care services an individual health care worker is authorized to perform by virtue of professional licence, registration or certification...” (p. 35)"
        }
      ],
      "skos:scopeNote": "Cited as: WHO guideline on health workforce development, attraction, recruitment and retention in rural and remote areas. Geneva: WHO; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 48",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/stewardship--who-wpro-hwf-framework-2024",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Stewardship"
        }
      ],
      "skos:definition": [
        {
          "@value": "A responsibility for the effective planning and management of health resources to safeguard equity, population health and well-being (2)"
        }
      ],
      "skos:scopeNote": "Cited as: Regional framework to shape a health workforce for the future of the Western Pacific. Manila: World Health Organization Regional Office for the Western Pacific; 2024.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 49",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/stock--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Stock (of health workers)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The total number of health workers potentially available in a country, including those participating in the health labour market, plus those who are qualified to do so but do not participate for some reason, such as early retirement."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 50",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates/supply--who-hlma-2021",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/dth-hrh/ns#glossary/twg-candidates"
      },
      "skos:prefLabel": [
        {
          "@value": "Supply (of health workers)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The number of health workers active in the health labour market, either in employment or not employed but willing to work."
        }
      ],
      "skos:scopeNote": "Cited as: Health labour market analysis guidebook. Geneva: World Health Organization; 2021.",
      "dcterms:source": "library/twg-glossary-2026-09-29/HWF_registry_DTH_Glossary_DRAFT.xlsx#General glossary!row 51",
      "skos:note": "candidate"
    }
  ]
}
