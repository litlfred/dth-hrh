        <di:waypoint x="900" y="520" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_08_di" bpmnElement="Flow_BP03_08">
        <di:waypoint x="985" y="554" />
        <di:waypoint x="985" y="636" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_09_di" bpmnElement="Flow_BP03_09">
        <di:waypoint x="1070" y="670" />
        <di:waypoint x="1095" y="670" />
